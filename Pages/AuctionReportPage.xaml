<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.AuctionReportPage"
             x:Name="ThisPage"
             x:DataType="vm:AuctionReportViewModel"
             Title="Auction Report"
             HideSoftInputOnTapped="True">

    <!-- Frozen Player (130) + scrollable: Lot 3 | Prices 4 | Captain 4 = 11 cols -->
    <Grid Padding="10" RowDefinitions="*,Auto" VerticalOptions="Fill">

        <!-- ===== TABLE ===== -->
        <Grid IsVisible="{Binding ShowTable}"
              RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="8"
              VerticalOptions="Fill">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="All-time Auction Report"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Button Grid.Column="1"
                        Text="Refresh"
                        Padding="14,8"
                        Style="{StaticResource GoldButton}"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding CanLoad}" />
            </Grid>

            <ctrl:FilterDrawer Grid.Row="1"
                               HasActiveFilters="{Binding HasActiveFilters}"
                               ClearCommand="{Binding ClearFiltersCommand}">
                <SearchBar Placeholder="Search by player name"
                           Text="{Binding PlayerNameFilter}"
                           CancelButtonColor="{StaticResource Primary}" />
            </ctrl:FilterDrawer>

            <Label Grid.Row="2"
                   Text="{Binding SummaryText}"
                   Style="{StaticResource MutedLabel}" />

            <VerticalStackLayout Grid.Row="3"
                                 Spacing="6"
                                 VerticalOptions="Fill">
                <Label Text="{Binding SortedByText}"
                       FontSize="11"
                       Margin="4,0,4,0"
                       TextColor="{StaticResource Primary}" />

                <ScrollView x:Name="AuctionTableScroll"
                            Orientation="Vertical"
                            VerticalOptions="Fill"
                            VerticalScrollBarVisibility="Always"
                            HorizontalScrollBarVisibility="Never">
                    <Grid ColumnDefinitions="130,*" ColumnSpacing="0" VerticalOptions="Start">

                        <Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="0">
                            <Grid>
                            <VerticalStackLayout Spacing="0">
                                <BoxView HeightRequest="64" Color="Transparent" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                                    <BindableLayout.EmptyView>
                                        <Label Text="No auction participation yet."
                                               Margin="8,16"
                                               FontSize="12"
                                               Style="{StaticResource MutedLabel}" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:AuctionReportRow">
                                            <Grid HeightRequest="36" Padding="4,0,8,0">
                                                <Label Text="{Binding PlayerName}"
                                                       FontAttributes="Bold"
                                                       FontSize="11"
                                                       TextColor="#1565C0"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.OpenPlayerCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="AuctionNameHeaderHost"
                                                 VerticalOptions="Start"
                                                 ZIndex="20"
                                                 Spacing="0"
                                                 BackgroundColor="{StaticResource Primary}">
                                <Grid HeightRequest="28"
                                      Padding="4,6"
                                      BackgroundColor="{StaticResource Primary}">
                                    <Label Text="Player"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           VerticalOptions="Center"
                                           TextColor="White" />
                                </Grid>
                                <Grid HeightRequest="36"
                                      Padding="2,4"
                                      BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#212121}">
                                    <Button Text="Player"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Primary}"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0"
                                            Margin="0"
                                            HeightRequest="28"
                                            Command="{Binding SortCommand}"
                                            CommandParameter="PlayerName" />
                                </Grid>
                            </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <ScrollView Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Always"
                                    VerticalScrollBarVisibility="Never">
                            <Grid>
                            <VerticalStackLayout Spacing="0">
                                <BoxView HeightRequest="64" Color="Transparent" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:AuctionReportRow">
                                            <Grid ColumnDefinitions="40,40,48,56,56,52,56,40,64,56,56"
                                                  HeightRequest="36"
                                                  Padding="2,0">
                                                <Label Text="{Binding AuctionsParticipated}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding TimesSold}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding TimesUnsold}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="3" Text="{Binding TotalBasePrice, StringFormat='{0:N0}'}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="4" Text="{Binding TotalSoldAmount, StringFormat='{0:N0}'}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="5" Text="{Binding AverageSoldPrice, StringFormat='{0:N1}'}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="6" Text="{Binding HighestSoldPrice, StringFormat='{0:N0}'}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="7" Text="{Binding TimesAsCaptain}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="8" Text="{Binding TotalWalletAssigned, StringFormat='{0:N0}'}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="9" Text="{Binding TotalSpentAsCaptain, StringFormat='{0:N0}'}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Label Grid.Column="10" Text="{Binding WalletRemaining, StringFormat='{0:N0}'}" FontSize="11" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="AuctionStatsHeaderHost"
                                                 VerticalOptions="Start"
                                                 ZIndex="20"
                                                 Spacing="0">
                                <Grid ColumnDefinitions="40,40,48,56,56,52,56,40,64,56,56"
                                      HeightRequest="28"
                                      Padding="4,6"
                                      BackgroundColor="{StaticResource Primary}">
                                    <Label Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="Lot"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Secondary}" />
                                    <Label Grid.Column="3" Grid.ColumnSpan="4"
                                           Text="Prices"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Secondary}" />
                                    <Label Grid.Column="7" Grid.ColumnSpan="4"
                                           Text="Captain"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </Grid>
                                <Grid ColumnDefinitions="40,40,48,56,56,52,56,40,64,56,56"
                                      HeightRequest="36"
                                      Padding="2,4"
                                      BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#212121}">
                                    <Button Text="Auc" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="AuctionsParticipated" />
                                    <Button Grid.Column="1" Text="Sold" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="TimesSold" />
                                    <Button Grid.Column="2" Text="Unsold" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="TimesUnsold" />
                                    <Button Grid.Column="3" Text="B.Tot" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="TotalBasePrice" />
                                    <Button Grid.Column="4" Text="S.Tot" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="TotalSoldAmount" />
                                    <Button Grid.Column="5" Text="Avg" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="AverageSoldPrice" />
                                    <Button Grid.Column="6" Text="High" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="HighestSoldPrice" />
                                    <Button Grid.Column="7" Text="×Cap" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="TimesAsCaptain" />
                                    <Button Grid.Column="8" Text="Wallet" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="TotalWalletAssigned" />
                                    <Button Grid.Column="9" Text="Spent" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="TotalSpentAsCaptain" />
                                    <Button Grid.Column="10" Text="Left" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" HeightRequest="28" HorizontalOptions="Fill" Command="{Binding SortCommand}" CommandParameter="WalletRemaining" />
                                </Grid>
                            </VerticalStackLayout>
                            </Grid>
                        </ScrollView>
                    </Grid>
                </ScrollView>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== PLAYER DETAIL (like Statistics player page) ===== -->
        <ScrollView IsVisible="{Binding ShowDetail}"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Default"
                    HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="4" Spacing="12" VerticalOptions="Start">

                <Button Text="← Back to report"
                        Command="{Binding BackToTableCommand}"
                        Style="{StaticResource GhostButton}"
                        HorizontalOptions="Start"
                        Padding="12,8" />

                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource Primary}"
                        Padding="18"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PLAYER AUCTION DETAILS"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                        <Label Text="{Binding DetailTitle}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="{Binding Selected.AuctionsParticipated, StringFormat='All-time across {0} auctions'}"
                               FontSize="13"
                               TextColor="#B8C4D4" />
                    </VerticalStackLayout>
                </Border>

                <!-- Lot career -->
                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="As auction lot" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Auctions" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.AuctionsParticipated}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Sold" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.TimesSold}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Unsold" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.TimesUnsold}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Base total" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.TotalBasePrice, StringFormat='{0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Sold total" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.TotalSoldAmount, StringFormat='{0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Avg / High" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                    <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource SecondaryDarkText}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} / {1:N0}">
                                                <Binding Path="Selected.AverageSoldPriceText" />
                                                <Binding Path="Selected.HighestSoldPrice" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Captain career -->
                <Border Style="{StaticResource CardBorder}" Padding="14"
                        IsVisible="{Binding Selected.HasCaptainWallet}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="As captain" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="× Cap" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.TimesAsCaptain}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Wallet" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.TotalWalletAssigned, StringFormat='{0:N0}'}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Spent" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.TotalSpentAsCaptain, StringFormat='{0:N0}'}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Left" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Selected.WalletRemaining, StringFormat='{0:N0}'}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource SecondaryDarkText}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Per-auction lot history -->
                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Auction history (as lot)" Style="{StaticResource SectionLabel}" Margin="0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DetailLots}"
                                             Spacing="8"
                                             IsVisible="{Binding HasDetailLots}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:AuctionPlayerLotEvent">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                            Padding="12"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding AuctionTitle}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding DateText}"
                                                   FontSize="12"
                                                   Style="{StaticResource MutedLabel}" />
                                            <Label Text="{Binding BaseLine}"
                                                   FontSize="12"
                                                   Style="{StaticResource MutedLabel}" />
                                            <Label Text="{Binding ResultLine}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Secondary}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="No lot appearances yet."
                               Style="{StaticResource MutedLabel}"
                               IsVisible="{Binding HasNoDetailLots}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Per-auction captain history -->
                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Auction history (as captain)" Style="{StaticResource SectionLabel}" Margin="0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DetailCaptainEvents}"
                                             Spacing="8"
                                             IsVisible="{Binding HasDetailCaptainEvents}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:AuctionPlayerCaptainEvent">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                            Padding="12"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding AuctionTitle}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding DateText}"
                                                   FontSize="12"
                                                   Style="{StaticResource MutedLabel}" />
                                            <Label Text="{Binding WalletLine}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Secondary}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Never a captain in an auction."
                               Style="{StaticResource MutedLabel}"
                               IsVisible="{Binding HasNoDetailCaptainEvents}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />

        <!-- Shown on load and when tapping a column header to sort -->
        <Grid Grid.Row="0"
              IsVisible="{Binding ShowLoading}"
              ZIndex="10"
              BackgroundColor="#66000000">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10"
                                 Padding="24">
                <ActivityIndicator IsRunning="{Binding ShowLoading}"
                                   Color="White"
                                   HeightRequest="48"
                                   WidthRequest="48"
                                   HorizontalOptions="Center" />
                <Label Text="{Binding LoadingMessage}"
                       TextColor="White"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
