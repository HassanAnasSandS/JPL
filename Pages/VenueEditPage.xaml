<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             x:Class="JPL.Pages.VenueEditPage"
             x:DataType="vm:VenueEditViewModel"
             Title="{Binding PageTitle}"
             HideSoftInputOnTapped="True">

    <VerticalStackLayout Padding="16" Spacing="14">
        <Border Style="{StaticResource CardBorder}" Padding="14">
            <VerticalStackLayout Spacing="10">
                <Label Text="Venue name *" Style="{StaticResource SectionLabel}" />
                <Entry Placeholder="e.g. Falcon"
                       Text="{Binding Name}"
                       MaxLength="160"
                       FontSize="16" />
            </VerticalStackLayout>
        </Border>
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
        <Button Text="Save"
                Style="{StaticResource GoldButton}"
                HeightRequest="48"
                Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>
