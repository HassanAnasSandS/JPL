<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.MatchScorecardPage"
             x:DataType="vm:MatchScorecardViewModel"
             Title="Scorecard"
             Shell.NavBarIsVisible="{Binding ShowShellNavBar}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid VerticalOptions="Fill">
    <Grid RowDefinitions="Auto,*,Auto" Padding="10,8" RowSpacing="6" VerticalOptions="Fill">

        <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowMainScorecard}">
            <Border StrokeThickness="0"
                    BackgroundColor="#C62828"
                    Padding="8,4"
                    StrokeShape="RoundRectangle 8"
                    IsVisible="{Binding IsLiveWatching}">
                <Label Text="{Binding LiveBannerText}"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />
            </Border>

            <Border StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="12,8"
                    StrokeShape="RoundRectangle 14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDetailScorecardCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Title}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="White"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                BackgroundColor="#C62828"
                                Padding="8,2"
                                StrokeShape="RoundRectangle 8"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsLiveWatching}">
                            <Label Text="LIVE"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding MetaLine}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding TossText}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           IsVisible="{Binding HasTossText}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding CaptainsLine}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           IsVisible="{Binding HasCaptainsLine}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />

                    <Grid ColumnDefinitions="*,36,*" ColumnSpacing="6" Padding="0,2,0,0">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding TeamAName}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding TeamAScore}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap"
                                   MaxLines="1"
                                   FontAutoScalingEnabled="False"
                                   TextColor="{StaticResource Secondary}" />
                            <Border StrokeThickness="0"
                                    BackgroundColor="#1B7A3D"
                                    Padding="6,1"
                                    StrokeShape="RoundRectangle 6"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding TeamAWon}">
                                <Label Text="WINNER"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="VS"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Secondary}" />

                        <VerticalStackLayout Grid.Column="2" Spacing="1">
                            <Label Text="{Binding TeamBName}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="End"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding TeamBScore}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"
                                   LineBreakMode="NoWrap"
                                   MaxLines="1"
                                   FontAutoScalingEnabled="False"
                                   TextColor="{StaticResource Secondary}" />
                            <Border StrokeThickness="0"
                                    BackgroundColor="#1B7A3D"
                                    Padding="6,1"
                                    StrokeShape="RoundRectangle 6"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding TeamBWon}">
                                <Label Text="WINNER"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="BATTER"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   TextColor="#8A9BB0" />
                            <Label Text="{Binding CurrentBatter}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="BOWLER"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   TextColor="#8A9BB0" />
                            <Label Text="{Binding CurrentBowler}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="0">
                            <Label Text="OVER"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   TextColor="#8A9BB0" />
                            <Label Text="{Binding CurrentOver}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap"
                                   FontAutoScalingEnabled="False"
                                   TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="0">
                            <Label Text="TOTAL"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   TextColor="#8A9BB0" />
                            <Label Text="{Binding TotalOvers}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap"
                                   FontAutoScalingEnabled="False"
                                   TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border StrokeThickness="0"
                            BackgroundColor="#243447"
                            Padding="10,8"
                            StrokeShape="RoundRectangle 10"
                            IsVisible="{Binding HasChaseDetails}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding ChaseNeedText}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource Secondary}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                    <Label Text="CRR"
                                           FontSize="9"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#8A9BB0" />
                                    <Label Text="{Binding CurrentRunRateText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="White" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="RRR"
                                           FontSize="9"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#8A9BB0" />
                                    <Label Text="{Binding RequiredRunRateText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ResultText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Secondary}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding CurrentInningsLine}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           IsVisible="{Binding HasCurrentInningsLine}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                          IsVisible="{Binding HasPlayerOfTheMatch}">
                        <Border StrokeThickness="0"
                                BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="22"
                                HeightRequest="22"
                                StrokeShape="RoundRectangle 11"
                                VerticalOptions="Center">
                            <Label Text="â˜…"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="{Binding PlayerOfTheMatchText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                    </Grid>

                    <Label Text="{Binding ScorecardTapHint}"
                           FontSize="9"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Analytics"
                    Style="{StaticResource GoldButton}"
                    Padding="8,10"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    Command="{Binding OpenAnalyticsCommand}"
                    IsVisible="{Binding ShowAnalyticsButton}" />
            <Button Text="Live"
                    Style="{StaticResource GoldButton}"
                    Padding="8,10"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    Command="{Binding OpenLiveStreamCommand}"
                    IsVisible="{Binding ShowLiveButton}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" VerticalOptions="Fill"
                     IsVisible="{Binding ShowDetailPane}"
                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                     Command="{Binding RefreshCommand}">
            <ScrollView VerticalOptions="Fill"
                        VerticalScrollBarVisibility="Default"
                        HorizontalScrollBarVisibility="Never">

                <VerticalStackLayout Spacing="12" VerticalOptions="Start" Padding="0,0,0,8">

                    <Border Style="{StaticResource CardBorder}"
                            IsVisible="{Binding ShowPlaceholder}"
                            Padding="20">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Loading scorecardâ€¦"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding IsBusy}" />
                            <Label Text="Pull down to refresh the scorecard."
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding ShowIdlePlaceholder}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding HasScorecard}">

                        <Button Text="â† Back to scorecard"
                                Style="{StaticResource GoldButton}"
                                Padding="12,10"
                                FontSize="14"
                                HorizontalOptions="Fill"
                                Command="{Binding ToggleDetailScorecardCommand}"
                                IsVisible="{Binding ShowFullScorecard}" />
                        <Button Text="Analytics"
                                Style="{StaticResource GoldButton}"
                                Padding="12,10"
                                FontSize="14"
                                HorizontalOptions="Fill"
                                Command="{Binding OpenAnalyticsCommand}"
                                IsVisible="{Binding ShowFullScorecard}" />

                        <Border StrokeThickness="0"
                                BackgroundColor="{StaticResource Primary}"
                                Padding="14,12"
                                StrokeShape="RoundRectangle 14"
                                IsVisible="{Binding ShowFullScorecard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding MetaLine}"
                                       FontSize="11"
                                       TextColor="#B8C4D4"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding TossText}"
                                       FontSize="11"
                                       TextColor="#B8C4D4"
                                       IsVisible="{Binding HasTossText}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding CaptainsLine}"
                                       FontSize="11"
                                       TextColor="#B8C4D4"
                                       IsVisible="{Binding HasCaptainsLine}"
                                       LineBreakMode="WordWrap" />

                                <Grid ColumnDefinitions="*,36,*" ColumnSpacing="6" Padding="0,4,0,0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding TeamAName}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TeamAScore}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}" />
                                        <Label Text="WINNER"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#7CFF6B"
                                               IsVisible="{Binding TeamAWon}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="VS"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Secondary}" />
                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                        <Label Text="{Binding TeamBName}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalTextAlignment="End"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TeamBScore}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource Secondary}" />
                                        <Label Text="WINNER"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               TextColor="#7CFF6B"
                                               IsVisible="{Binding TeamBWon}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="{Binding ResultText}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Secondary}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding PlayerOfTheMatchText}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding HasPlayerOfTheMatch}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Full batting / bowling card â€” tap the main scorecard to open -->
                        <ctrl:MatchScorecardInningsView IsVisible="{Binding ShowFullScorecard}"
                                                        Innings="{Binding Innings}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />
    </Grid>

        <Grid IsVisible="{Binding ShowLiveOverlay}"
              BackgroundColor="#000000"
              ZIndex="40"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WebView Source="{Binding StreamSource}"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />

            <Button Text="Close"
                    Style="{StaticResource GoldButton}"
                    Padding="14,8"
                    FontSize="13"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="12,12,0,0"
                    Command="{Binding CloseLiveStreamCommand}" />

            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="8,8,8,12">
                <Border StrokeThickness="0"
                        BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDetailScorecardCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <Border StrokeThickness="0"
                                BackgroundColor="#123D42"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="120">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="â–¶"
                                       FontSize="12"
                                       TextColor="#7CFF6B"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding StrikerName}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding StrikerScore}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#B6FF3B" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <Border StrokeThickness="0"
                                BackgroundColor="#123D42"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="110">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding NonStrikerName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding NonStrikerScore}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#B6FF3B" />
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeThickness="0"
                                BackgroundColor="#4A1F63"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="140">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding BugTeamScore}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="8,2"
                                        StrokeShape="RoundRectangle 10">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="Ov"
                                               FontSize="9"
                                               TextColor="#4A1F63"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding BugOvers}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#0D1B2A" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding CurrentRunRateText, StringFormat='CRR {0}'}"
                                       FontSize="10"
                                       TextColor="#E0C6FF" />
                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding ChaseNeedText}"
                                       FontSize="10"
                                       TextColor="#B6FF3B"
                                       IsVisible="{Binding HasChaseDetails}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>

                        <Border StrokeThickness="0"
                                BackgroundColor="#0F3D2E"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="160">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding BowlerName}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding BowlerBugLine}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#B6FF3B" />
                                </Grid>
                                <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ThisOverBalls}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OverBallChip">
                                            <Border StrokeThickness="0"
                                                    WidthRequest="26"
                                                    HeightRequest="26"
                                                    BackgroundColor="{Binding Background}"
                                                    StrokeShape="RoundRectangle 13">
                                                <Label Text="{Binding Text}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding Foreground}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <Grid IsVisible="{Binding ShowDetailScorecardModal}"
              InputTransparent="False"
              ZIndex="50"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <BoxView Color="#CC000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseDetailScorecardModalCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                    StrokeShape="RoundRectangle 16"
                    Margin="10,28,10,12"
                    Padding="0"
                    VerticalOptions="Fill">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Padding="12,10" BackgroundColor="{StaticResource Primary}">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Scorecard"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding ResultText}"
                                   FontSize="11"
                                   TextColor="#B8C4D4"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Close"
                                Style="{StaticResource GoldButton}"
                                Padding="14,8"
                                FontSize="13"
                                VerticalOptions="Center"
                                Command="{Binding CloseDetailScorecardModalCommand}" />
                    </Grid>
                    <ScrollView Grid.Row="1"
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Default"
                                Padding="10,10,10,14">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,36,*" ColumnSpacing="6">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding TeamAName}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TeamAScore}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="VS"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource Secondary}" />
                                <VerticalStackLayout Grid.Column="2" Spacing="1">
                                    <Label Text="{Binding TeamBName}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TeamBScore}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                            </Grid>
                            <ctrl:MatchScorecardInningsView Innings="{Binding Innings}" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
