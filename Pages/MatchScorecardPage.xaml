<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.MatchScorecardPage"
             x:Name="ScorecardRoot"
             x:DataType="vm:MatchScorecardViewModel"
             Title="Scorecard"
             Shell.NavBarIsVisible="{Binding ShowShellNavBar}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid VerticalOptions="Fill">
    <Grid RowDefinitions="Auto,*,Auto" Padding="10,8" RowSpacing="6" VerticalOptions="Fill">

        <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowMainScorecard}">
            <Border StrokeThickness="0"
                    BackgroundColor="#C62828"
                    Padding="8,4"
                    StrokeShape="RoundRectangle 8"
                    IsVisible="{Binding IsLiveWatching}">
                <Label Text="{Binding LiveBannerText}"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="White" />
            </Border>

            <Border StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="12,8"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="5">
                    <VerticalStackLayout Spacing="5">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDetailScorecardCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Title}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="White"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                BackgroundColor="#C62828"
                                Padding="8,2"
                                StrokeShape="RoundRectangle 8"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsLiveWatching}">
                            <Label Text="LIVE"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding MetaLine}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding TossText}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           IsVisible="{Binding HasTossText}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding CaptainsLine}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           IsVisible="{Binding HasCaptainsLine}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />

                    <Grid ColumnDefinitions="*,36,*" ColumnSpacing="6" Padding="0,2,0,0">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding TeamAName}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding TeamAScore}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap"
                                   MaxLines="1"
                                   FontAutoScalingEnabled="False"
                                   TextColor="{StaticResource Secondary}" />
                            <Border StrokeThickness="0"
                                    BackgroundColor="#1B7A3D"
                                    Padding="6,1"
                                    StrokeShape="RoundRectangle 6"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding TeamAWon}">
                                <Label Text="WINNER"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="VS"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Secondary}" />

                        <VerticalStackLayout Grid.Column="2" Spacing="1">
                            <Label Text="{Binding TeamBName}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="End"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding TeamBScore}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"
                                   LineBreakMode="NoWrap"
                                   MaxLines="1"
                                   FontAutoScalingEnabled="False"
                                   TextColor="{StaticResource Secondary}" />
                            <Border StrokeThickness="0"
                                    BackgroundColor="#1B7A3D"
                                    Padding="6,1"
                                    StrokeShape="RoundRectangle 6"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding TeamBWon}">
                                <Label Text="WINNER"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Border StrokeThickness="0"
                            BackgroundColor="#1B2B40"
                            Padding="10,8"
                            StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="BATTER"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="#8A9BB0" />
                                <Label Text="{Binding CurrentBatter}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="BOWLER"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="#8A9BB0" />
                                <Label Text="{Binding CurrentBowler}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="1">
                                <Label Text="OVER"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       HorizontalTextAlignment="End"
                                       TextColor="#8A9BB0" />
                                <Label Text="{Binding CurrentOver}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       LineBreakMode="NoWrap"
                                       HorizontalTextAlignment="End"
                                       FontAutoScalingEnabled="False"
                                       TextColor="{StaticResource Secondary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="1">
                                <Label Text="OF"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       HorizontalTextAlignment="End"
                                       TextColor="#8A9BB0" />
                                <Label Text="{Binding TotalOvers}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       LineBreakMode="NoWrap"
                                       HorizontalTextAlignment="End"
                                       FontAutoScalingEnabled="False"
                                       TextColor="{StaticResource Secondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border StrokeThickness="0"
                            BackgroundColor="#243447"
                            Padding="10,8"
                            StrokeShape="RoundRectangle 10"
                            IsVisible="{Binding HasChaseDetails}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding ChaseNeedText}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource Secondary}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                    <Label Text="CRR"
                                           FontSize="9"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#8A9BB0" />
                                    <Label Text="{Binding CurrentRunRateText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="White" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="RRR"
                                           FontSize="9"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#8A9BB0" />
                                    <Label Text="{Binding RequiredRunRateText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ResultText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Secondary}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding CurrentInningsLine}"
                           FontSize="10"
                           TextColor="#B8C4D4"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           IsVisible="{Binding HasCurrentInningsLine}" />
                    </VerticalStackLayout>

                    <!-- Player of the Match — tap for the full points table. Kept as a sibling of
                         the tappable info stack so the two tap targets never overlap. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                          Padding="0,2"
                          IsVisible="{Binding HasPlayerOfTheMatch}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPlayerPointsCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0"
                                BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="22"
                                HeightRequest="22"
                                StrokeShape="RoundRectangle 11"
                                VerticalOptions="Center">
                            <Label Text="★"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="{Binding PlayerOfTheMatchText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2"
                               Text="Points ›"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Border StrokeThickness="0"
                            BackgroundColor="#243447"
                            Padding="10,3"
                            StrokeShape="RoundRectangle 9"
                            HorizontalOptions="Center">
                        <Label Text="{Binding ScorecardTapHint}"
                               FontSize="9"
                               FontAttributes="Bold"
                               CharacterSpacing="0.5"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Secondary}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Scorecard sits next to Analytics so the full card is always one tap away -->
            <Grid ColumnDefinitions="*,*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding ShowAnalyticsButton}">
                <Button Text="Scorecard"
                        Style="{StaticResource GoldButton}"
                        Padding="8,10"
                        FontSize="15"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        Command="{Binding OpenDetailScorecardCommand}" />
                <Button Grid.Column="1"
                        Text="Analytics"
                        Style="{StaticResource OutlineButton}"
                        Padding="8,10"
                        FontSize="15"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        Command="{Binding OpenAnalyticsCommand}" />
                <Button Grid.Column="2"
                        Text="Live"
                        Style="{StaticResource DangerButton}"
                        Padding="14,10"
                        FontSize="15"
                        FontAttributes="Bold"
                        Command="{Binding OpenLiveStreamCommand}"
                        IsVisible="{Binding ShowLiveButton}" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" VerticalOptions="Fill"
                     IsVisible="{Binding ShowDetailPane}"
                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                     Command="{Binding RefreshCommand}">
            <ScrollView VerticalOptions="Fill"
                        VerticalScrollBarVisibility="Default"
                        HorizontalScrollBarVisibility="Never">

                <VerticalStackLayout Spacing="12" VerticalOptions="Start" Padding="0,0,0,8">

                    <Border Style="{StaticResource CardBorder}"
                            IsVisible="{Binding ShowPlaceholder}"
                            Padding="20">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Loading scorecard…"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding IsBusy}" />
                            <Label Text="Pull down to refresh the scorecard."
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding ShowIdlePlaceholder}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding HasScorecard}">

                        <Button Text="← Back to summary"
                                Style="{StaticResource OutlineButton}"
                                Padding="12,10"
                                FontSize="14"
                                HorizontalOptions="Fill"
                                Command="{Binding ToggleDetailScorecardCommand}"
                                IsVisible="{Binding ShowFullScorecard}" />
                        <Button Text="Analytics"
                                Style="{StaticResource GoldButton}"
                                Padding="12,10"
                                FontSize="14"
                                HorizontalOptions="Fill"
                                Command="{Binding OpenAnalyticsCommand}"
                                IsVisible="{Binding ShowFullScorecard}" />

                        <Border StrokeThickness="0"
                                BackgroundColor="{StaticResource Primary}"
                                Padding="14,12"
                                StrokeShape="RoundRectangle 14"
                                IsVisible="{Binding ShowFullScorecard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding MetaLine}"
                                       FontSize="11"
                                       TextColor="#B8C4D4"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding TossText}"
                                       FontSize="11"
                                       TextColor="#B8C4D4"
                                       IsVisible="{Binding HasTossText}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding CaptainsLine}"
                                       FontSize="11"
                                       TextColor="#B8C4D4"
                                       IsVisible="{Binding HasCaptainsLine}"
                                       LineBreakMode="WordWrap" />

                                <Grid ColumnDefinitions="*,36,*" ColumnSpacing="6" Padding="0,4,0,0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding TeamAName}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TeamAScore}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}" />
                                        <Label Text="WINNER"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#7CFF6B"
                                               IsVisible="{Binding TeamAWon}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="VS"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource Secondary}" />
                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                        <Label Text="{Binding TeamBName}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalTextAlignment="End"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TeamBScore}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource Secondary}" />
                                        <Label Text="WINNER"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               TextColor="#7CFF6B"
                                               IsVisible="{Binding TeamBWon}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="{Binding ResultText}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Secondary}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                                <Grid IsVisible="{Binding HasPlayerOfTheMatch}">
                                    <Label Text="{Binding PlayerOfTheMatchText}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap" />
                                    <Button Text=""
                                            BackgroundColor="#01000000"
                                            BorderWidth="0"
                                            Padding="0"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            Command="{Binding OpenPlayerPointsCommand}"
                                            SemanticProperties.Description="Show Player of the Match points for every player" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Full batting / bowling card — opened from the Scorecard button or by tapping the summary -->
                        <ctrl:MatchScorecardInningsView IsVisible="{Binding ShowFullScorecard}"
                                                        Innings="{Binding Innings}"
                                                        PlayerTappedCommand="{Binding OpenPlayerReportCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />
    </Grid>

        <Grid IsVisible="{Binding ShowLiveOverlay}"
              BackgroundColor="#000000"
              ZIndex="40"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WebView Source="{Binding StreamSource}"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />

            <Button Text="Close"
                    Style="{StaticResource GoldButton}"
                    Padding="14,8"
                    FontSize="13"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="12,12,0,0"
                    Command="{Binding CloseLiveStreamCommand}" />

            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="8,8,8,12">
                <Border StrokeThickness="0"
                        BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDetailScorecardCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <Border StrokeThickness="0"
                                BackgroundColor="#123D42"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="120">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="▶"
                                       FontSize="12"
                                       TextColor="#7CFF6B"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding StrikerName}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding StrikerScore}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#B6FF3B" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <Border StrokeThickness="0"
                                BackgroundColor="#123D42"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="110">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding NonStrikerName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding NonStrikerScore}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#B6FF3B" />
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeThickness="0"
                                BackgroundColor="#4A1F63"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="140">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding BugTeamScore}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="8,2"
                                        StrokeShape="RoundRectangle 10">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="Ov"
                                               FontSize="9"
                                               TextColor="#4A1F63"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding BugOvers}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#0D1B2A" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding CurrentRunRateText, StringFormat='CRR {0}'}"
                                       FontSize="10"
                                       TextColor="#E0C6FF" />
                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding ChaseNeedText}"
                                       FontSize="10"
                                       TextColor="#B6FF3B"
                                       IsVisible="{Binding HasChaseDetails}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>

                        <Border StrokeThickness="0"
                                BackgroundColor="#0F3D2E"
                                Padding="10,8"
                                StrokeShape="RoundRectangle 12"
                                MinimumWidthRequest="160">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding BowlerName}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding BowlerBugLine}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#B6FF3B" />
                                </Grid>
                                <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ThisOverBalls}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OverBallChip">
                                            <Border StrokeThickness="0"
                                                    WidthRequest="26"
                                                    HeightRequest="26"
                                                    BackgroundColor="{Binding Background}"
                                                    StrokeShape="RoundRectangle 13">
                                                <Label Text="{Binding Text}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding Foreground}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <Grid IsVisible="{Binding ShowDetailScorecardModal}"
              InputTransparent="False"
              ZIndex="50"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <BoxView Color="#CC000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseDetailScorecardModalCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                    StrokeShape="RoundRectangle 16"
                    Margin="10,28,10,12"
                    Padding="0"
                    VerticalOptions="Fill">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Padding="12,10" BackgroundColor="{StaticResource Primary}">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Scorecard"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding ResultText}"
                                   FontSize="11"
                                   TextColor="#B8C4D4"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Close"
                                Style="{StaticResource GoldButton}"
                                Padding="14,8"
                                FontSize="13"
                                VerticalOptions="Center"
                                Command="{Binding CloseDetailScorecardModalCommand}" />
                    </Grid>
                    <ScrollView Grid.Row="1"
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Default"
                                Padding="10,10,10,14">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,36,*" ColumnSpacing="6">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding TeamAName}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TeamAScore}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="VS"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource Secondary}" />
                                <VerticalStackLayout Grid.Column="2" Spacing="1">
                                    <Label Text="{Binding TeamBName}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TeamBScore}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                            </Grid>
                            <ctrl:MatchScorecardInningsView Innings="{Binding Innings}"
                                                            PlayerTappedCommand="{Binding OpenPlayerReportCommand}" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsPlayerReportOpen}"
              InputTransparent="False"
              ZIndex="70"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <BoxView Color="#CC000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClosePlayerReportCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                    StrokeShape="RoundRectangle 16"
                    Margin="10,28,10,12"
                    Padding="0"
                    VerticalOptions="Fill">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Padding="12,10" BackgroundColor="{StaticResource Primary}">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding PlayerReport.PlayerName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding PlayerReport.TeamName}"
                                   FontSize="11"
                                   TextColor="#B8C4D4"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Close"
                                Style="{StaticResource GoldButton}"
                                Padding="14,8"
                                FontSize="13"
                                VerticalOptions="Center"
                                Command="{Binding ClosePlayerReportCommand}" />
                    </Grid>
                    <ScrollView Grid.Row="1" Padding="12,10,12,16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Loading…"
                                   IsVisible="{Binding IsPlayerReportBusy}"
                                   Style="{StaticResource MutedLabel}" />
                            <VerticalStackLayout Spacing="12"
                                                 IsVisible="{Binding HasPlayerReport}">
                                <Label Text="{Binding PlayerReport.MatchTitle}"
                                       FontSize="12"
                                       Style="{StaticResource MutedLabel}"
                                       LineBreakMode="WordWrap" />

                                <Label Text="BATTING" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                <Label Text="{Binding PlayerReport.BattingSummary}" FontSize="13" FontAttributes="Bold" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlayerReport.BattingBalls}"
                                                     IsVisible="{Binding PlayerReport.HasBatting}"
                                                     Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:PlayerMatchBallLine">
                                            <Grid ColumnDefinitions="48,36,*" ColumnSpacing="8" Padding="0,2">
                                                <Label Text="{Binding OverText}" FontSize="11" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Mark}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                                    <Label Text="{Binding Detail}" FontSize="12" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding InningsLabel}" FontSize="10" Style="{StaticResource MutedLabel}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="BOWLING" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Secondary}" Margin="0,6,0,0" />
                                <Label Text="{Binding PlayerReport.BowlingSummary}" FontSize="13" FontAttributes="Bold" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlayerReport.BowlingBalls}"
                                                     IsVisible="{Binding PlayerReport.HasBowling}"
                                                     Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:PlayerMatchBallLine">
                                            <Grid ColumnDefinitions="48,36,*" ColumnSpacing="8" Padding="0,2">
                                                <Label Text="{Binding OverText}" FontSize="11" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Mark}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                                    <Label Text="{Binding Detail}" FontSize="12" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding InningsLabel}" FontSize="10" Style="{StaticResource MutedLabel}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="FIELDING" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Secondary}" Margin="0,6,0,0" />
                                <Label Text="{Binding PlayerReport.FieldingSummary}" FontSize="13" FontAttributes="Bold" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlayerReport.FieldingBalls}"
                                                     IsVisible="{Binding PlayerReport.HasFielding}"
                                                     Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:PlayerMatchBallLine">
                                            <Grid ColumnDefinitions="48,36,*" ColumnSpacing="8" Padding="0,2">
                                                <Label Text="{Binding OverText}" FontSize="11" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Mark}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                                    <Label Text="{Binding Detail}" FontSize="12" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding InningsLabel}" FontSize="10" Style="{StaticResource MutedLabel}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <!-- Player of the Match impact points — opened by tapping the ★ line. -->
        <Grid IsVisible="{Binding IsPlayerPointsOpen}"
              InputTransparent="False"
              ZIndex="75"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <BoxView Color="#CC000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClosePlayerPointsCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                    StrokeShape="RoundRectangle 16"
                    Margin="10,28,10,12"
                    Padding="0"
                    VerticalOptions="Fill">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Player of the Match headline -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                          Padding="12,10" BackgroundColor="{StaticResource Primary}">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding PlayerPointsSelectionTitle}"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{StaticResource Secondary}" />
                            <Label Text="{Binding PlayerPointsPotmName}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PlayerPointsPotmTeam}"
                                   FontSize="10"
                                   TextColor="#B8C4D4"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center"
                                             HorizontalOptions="End">
                            <Label Text="{Binding PlayerPointsPotmPoints}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"
                                   TextColor="{StaticResource Secondary}" />
                            <Label Text="POINTS"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   HorizontalTextAlignment="End"
                                   TextColor="#B8C4D4" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="✕"
                                Style="{StaticResource GoldButton}"
                                Padding="10,6"
                                FontSize="13"
                                VerticalOptions="Center"
                                Command="{Binding ClosePlayerPointsCommand}" />
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="14,10,14,4">
                        <Label Text="{Binding PlayerPointsPotmImpact}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                        <Label Text="HOW POINTS WERE EARNED"
                               FontSize="9"
                               FontAttributes="Bold"
                               CharacterSpacing="0.7"
                               TextColor="#8A9BB0" />
                        <Label Text="{Binding PlayerPointsPotmBreakdown}"
                               FontSize="11"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="2" Padding="12,4,12,14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Loading…"
                                   IsVisible="{Binding IsPlayerPointsBusy}"
                                   Style="{StaticResource MutedLabel}" />

                            <Label Text="{Binding PlayerPointsError}"
                                   IsVisible="{Binding ShowPlayerPointsError}"
                                   TextColor="{StaticResource Danger}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />

                            <Label Text="No player has earned points in this match yet."
                                   IsVisible="{Binding ShowPlayerPointsEmpty}"
                                   Style="{StaticResource MutedLabel}" />

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPlayerPoints}">
                                <Label Text="ALL PLAYERS · MATCH POINTS"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="{StaticResource Secondary}" />


                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlayerPoints}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:MatchPointsRow">
                                            <Border StrokeThickness="0"
                                                    BackgroundColor="#152A3F"
                                                    Padding="10,8"
                                                    StrokeShape="RoundRectangle 10">
                                                <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="8">
                                                    <Border StrokeThickness="0"
                                                            BackgroundColor="#243447"
                                                            WidthRequest="26"
                                                            HeightRequest="26"
                                                            StrokeShape="RoundRectangle 13"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding RankText}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               TextColor="{StaticResource Secondary}" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                            <Label Text="{Binding PlayerName}"
                                                                   FontSize="13"
                                                                   FontAttributes="Bold"
                                                                   TextColor="White"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Grid.Column="1"
                                                                   Text="★"
                                                                   FontSize="11"
                                                                   TextColor="{StaticResource Secondary}"
                                                                   VerticalOptions="Center"
                                                                   IsVisible="{Binding IsPlayerOfTheMatch}" />
                                                        </Grid>
                                                        <Label Text="{Binding BreakdownText}"
                                                               FontSize="10"
                                                               TextColor="#B8C4D4"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                                        <Label Text="{Binding PointsText}"
                                                               FontSize="18"
                                                               FontAttributes="Bold"
                                                               HorizontalTextAlignment="End"
                                                               TextColor="{StaticResource Secondary}" />
                                                        <Label Text="pts"
                                                               FontSize="8"
                                                               HorizontalTextAlignment="End"
                                                               TextColor="#8A9BB0" />
                                                    </VerticalStackLayout>
                                                    <Button Grid.ColumnSpan="3"
                                                            Text=""
                                                            BackgroundColor="#01000000"
                                                            BorderWidth="0"
                                                            Padding="0"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            Clicked="OnPlayerPointsRowClicked"
                                                            SemanticProperties.Description="Show this player's match points breakdown" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="{Binding PlayerPointsRules}"
                                       FontSize="9"
                                       TextColor="#8A9BB0"
                                       LineBreakMode="WordWrap"
                                       Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <!-- Player-specific points dialog, opened from any row in the match list. -->
        <Grid IsVisible="{Binding IsSelectedPlayerPointsOpen}"
              ZIndex="90"
              InputTransparent="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <BoxView Color="#CC000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseSelectedPlayerPointsCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                    StrokeShape="RoundRectangle 18"
                    Padding="0"
                    Margin="12"
                    MaximumWidthRequest="560"
                    MaximumHeightRequest="620"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                          Padding="18,14"
                          BackgroundColor="{StaticResource Primary}">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding PlayerPointsSelectionTitle}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{StaticResource Secondary}" />
                            <Label Text="{Binding SelectedPlayerPoints.PlayerName}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SelectedPlayerPoints.TeamName}"
                                   FontSize="12"
                                   TextColor="#B8C4D4" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource GoldButton}"
                                Padding="10,6"
                                FontSize="13"
                                VerticalOptions="Start"
                                Command="{Binding CloseSelectedPlayerPointsCommand}" />
                    </Grid>
                    <ScrollView Grid.Row="1" Padding="16,14">
                        <VerticalStackLayout Spacing="12">
                            <Border StrokeThickness="0"
                                    BackgroundColor="{StaticResource Primary}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="TOTAL MATCH POINTS"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"
                                               TextColor="#B8C4D4" />
                                        <Label Text="{Binding SelectedPlayerPoints.ImpactText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding SelectedPlayerPoints.PointsText}"
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </Grid>
                            </Border>

                            <Border Stroke="#D8E0EA"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#152A3F}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Batting"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SelectedPlayerPoints.BattingPointsText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedPlayerPoints.BattingFactors}"
                                                         Spacing="5">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RankingPart">
                                                <Border BackgroundColor="{AppThemeBinding Light=#F3F6FA, Dark=#20364B}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="10,7">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="{Binding Label}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                                            <Label Text="{Binding Stat}"
                                                                   FontSize="10"
                                                                   TextColor="#718096" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding PointsText}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border Stroke="#D8E0EA"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#152A3F}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Bowling"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SelectedPlayerPoints.BowlingPointsText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedPlayerPoints.BowlingFactors}"
                                                         Spacing="5">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RankingPart">
                                                <Border BackgroundColor="{AppThemeBinding Light=#F3F6FA, Dark=#20364B}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="10,7">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="{Binding Label}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                                            <Label Text="{Binding Stat}"
                                                                   FontSize="10"
                                                                   TextColor="#718096" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding PointsText}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border Stroke="#D8E0EA"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#152A3F}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Fielding"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SelectedPlayerPoints.FieldingPointsText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedPlayerPoints.FieldingFactors}"
                                                         Spacing="5">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RankingPart">
                                                <Border BackgroundColor="{AppThemeBinding Light=#F3F6FA, Dark=#20364B}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="10,7">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="{Binding Label}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                                            <Label Text="{Binding Stat}"
                                                                   FontSize="10"
                                                                   TextColor="#718096" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding PointsText}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="{Binding PlayerPointsRules}"
                                   FontSize="10"
                                   TextColor="#8A9BB0"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
