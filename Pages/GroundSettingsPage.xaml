<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.GroundSettingsPage"
             x:Name="ThisPage"
             x:DataType="vm:GroundSettingsViewModel"
             Title="Settings"
             HideSoftInputOnTapped="True">
    <ContentPage.Resources>
        <Style x:Key="SettingsTab" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="BackgroundColor" Value="#E8EEF5" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="14" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
        <HorizontalStackLayout Spacing="6">
            <ctrl:TabChipButton Text="Ground Amenities"
                                Style="{StaticResource SettingsTab}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="amenities">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAmenitiesTab}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                    </DataTrigger>
                </Button.Triggers>
            </ctrl:TabChipButton>
            <ctrl:TabChipButton Text="Ground Services"
                                Style="{StaticResource SettingsTab}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="services">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsServicesTab}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                    </DataTrigger>
                </Button.Triggers>
            </ctrl:TabChipButton>
        </HorizontalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Amenities}"
                                IsVisible="{Binding IsAmenitiesTab}">
                    <CollectionView.EmptyView>
                        <Label Text="No amenities yet. Add names owners can tick on a ground."
                               Padding="16"
                               TextColor="{StaticResource TextSecondary}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogRow">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                    <Button Grid.Column="1"
                                            Text="Edit"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            Command="{Binding BindingContext.EditCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#FFE8EC"
                                            TextColor="{StaticResource Danger}"
                                            Command="{Binding BindingContext.DeleteCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView ItemsSource="{Binding Services}"
                                IsVisible="{Binding IsServicesTab}">
                    <CollectionView.EmptyView>
                        <Label Text="No services yet. Add names owners can offer with a PKR amount."
                               Padding="16"
                               TextColor="{StaticResource TextSecondary}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogRow">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                    <Button Grid.Column="1"
                                            Text="Edit"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            Command="{Binding BindingContext.EditCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#FFE8EC"
                                            TextColor="{StaticResource Danger}"
                                            Command="{Binding BindingContext.DeleteCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="{Binding AddPlaceholder}"
                   Text="{Binding NewName}"
                   MaxLength="40"
                   ReturnCommand="{Binding AddCommand}" />
            <Button Grid.Column="1"
                    Text="Add"
                    Style="{StaticResource GoldButton}"
                    Command="{Binding AddCommand}" />
        </Grid>
        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />
    </Grid>
</ContentPage>
