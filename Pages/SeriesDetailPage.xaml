<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             x:Class="JPL.Pages.SeriesDetailPage"
             x:Name="ThisPage"
             x:DataType="vm:SeriesDetailViewModel"
             Title="Series"
             HideSoftInputOnTapped="True">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="14" Spacing="16">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding Name}"
                               FontSize="22"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Primary}" />
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SurfaceMuted}"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8"
                                VerticalOptions="Center">
                            <Label Text="{Binding StatusText}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding MetaLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                    <Label Text="{Binding MatchDefaultsLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                    <Label Text="{Binding ScoreLine}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding WinnerLine}"
                           IsVisible="{Binding HasWinner}"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{StaticResource Secondary}" />
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Button Text="Edit draft"
                                IsVisible="{Binding CanSave}"
                                Padding="12,8"
                                FontSize="12"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding EditCommand}" />
                        <Button Text="Save"
                                IsVisible="{Binding CanSave}"
                                Style="{StaticResource GoldButton}"
                                Padding="12,8"
                                FontSize="12"
                                Command="{Binding SaveCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasStandings}">
                    <Label Text="Series table" Style="{StaticResource SectionLabel}" />
                    <Label Text="Win 2 · Tie 1 · Loss 0  ·  winner by match wins"
                           Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,-4,0,0" />
                    <Grid ColumnDefinitions="28,*,28,28,28,28,36,52"
                          ColumnSpacing="2"
                          Padding="6,6"
                          BackgroundColor="{StaticResource Primary}">
                        <Label Text="#" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="Team" FontSize="10" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="2" Text="P" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="W" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="L" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="T" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="6" Text="Pts" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="7" Text="NRR" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Standings}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:SeriesStandingItem">
                                <Grid ColumnDefinitions="28,*,28,28,28,28,36,52"
                                      ColumnSpacing="2"
                                      Padding="6,8"
                                      BackgroundColor="{StaticResource SurfaceMuted}">
                                    <Label Text="{Binding Rank}" FontSize="12" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" VerticalOptions="Center"
                                           TextColor="{StaticResource Secondary}" />
                                    <Label Grid.Column="1" Text="{Binding TeamName}" FontSize="13" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Played}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                    <Label Grid.Column="3" Text="{Binding Won}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                    <Label Grid.Column="4" Text="{Binding Lost}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                    <Label Grid.Column="5" Text="{Binding Tied}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                    <Label Grid.Column="6" Text="{Binding Points}" FontSize="12" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource Primary}" />
                                    <Label Grid.Column="7" Text="{Binding NrrText}" FontSize="11"
                                           HorizontalTextAlignment="End" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Fixtures" Style="{StaticResource SectionLabel}" />
                    <Label Text="Save to create the schedule. Start matches one at a time."
                           IsVisible="{Binding IsDraft}"
                           Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,-4,0,0" />
                    <Label Text="No fixtures yet."
                           IsVisible="{Binding ShowNoFixtures}"
                           Style="{StaticResource MutedLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fixtures}" Spacing="0"
                                         IsVisible="{Binding HasFixtures}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:SeriesFixtureItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,12">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.OpenScorecardCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="11" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding VsLine}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding ResultText}" IsVisible="{Binding HasResult}"
                                               FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                        <Label Text="{Binding MatchStatusText}" FontSize="11" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                        <Button Text="Start" IsVisible="{Binding CanStart}"
                                                Style="{StaticResource GoldButton}" Padding="12,6" FontSize="11"
                                                MinimumHeightRequest="34"
                                                Command="{Binding BindingContext.StartFixtureCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Resume" IsVisible="{Binding CanResume}"
                                                Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11"
                                                MinimumHeightRequest="34"
                                                Command="{Binding BindingContext.ResumeFixtureCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="{Binding ScorecardLabel}" IsVisible="{Binding CanOpenScorecard}"
                                                Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11"
                                                MinimumHeightRequest="34"
                                                Command="{Binding BindingContext.OpenScorecardCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
