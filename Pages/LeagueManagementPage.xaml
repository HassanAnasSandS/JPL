<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.LeagueManagementPage"
             x:DataType="vm:LeagueManagementViewModel"
             Title="Leagues"
             HideSoftInputOnTapped="True">

    <Grid Padding="14" RowSpacing="10">

        <!-- Same module password gate as Users (one unlock covers both) -->
        <VerticalStackLayout IsVisible="{Binding ShowLockPanel}"
                             VerticalOptions="Center"
                             Spacing="14"
                             MaximumWidthRequest="420"
                             HorizontalOptions="Center">
            <Label Text="League management"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Primary}" />
            <Label Text="Enter module password to create, edit, activate or delete leagues."
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource MutedLabel}" />
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <Entry Placeholder="Module password"
                               Text="{Binding ModulePassword}"
                               IsPassword="{Binding IsPasswordHidden}"
                               ReturnType="Go"
                               ReturnCommand="{Binding UnlockCommand}"
                               FontSize="16" />
                        <Button Grid.Column="1"
                                Text="{Binding PasswordToggleIcon}"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="18"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                BorderWidth="0" />
                    </Grid>
                    <Button Text="Unlock"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding UnlockCommand}"
                            HeightRequest="48" />
                    <Label Text="{Binding UnlockError}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Management UI -->
        <Grid IsVisible="{Binding ShowManagement}"
              RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Leagues"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding CountLabel}"
                           FontSize="12"
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Lock"
                        Style="{StaticResource GhostButton}"
                        Padding="12,8"
                        Command="{Binding LockModuleCommand}" />
                <Button Grid.Column="2"
                        Text="+ Add"
                        Style="{StaticResource GoldButton}"
                        Padding="16,10"
                        IsVisible="{Binding CanWrite}"
                        Clicked="OnAddClicked" />
            </Grid>

            <ctrl:FilterDrawer Grid.Row="1"
                               HasActiveFilters="{Binding HasActiveFilters}"
                               ClearCommand="{Binding ClearFiltersCommand}">
                <VerticalStackLayout Spacing="8">
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{Binding AllFilterLabel}"
                                    Command="{Binding SelectStatusCommand}"
                                    CommandParameter="all"
                                    Padding="14,8"
                                    FontSize="13"
                                    CornerRadius="18"
                                    MinimumHeightRequest="40"
                                    BackgroundColor="#E8EEF5"
                                    TextColor="{StaticResource Primary}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsAllFilter}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding ActiveFilterLabel}"
                                    Command="{Binding SelectStatusCommand}"
                                    CommandParameter="active"
                                    Padding="14,8"
                                    FontSize="13"
                                    CornerRadius="18"
                                    MinimumHeightRequest="40"
                                    BackgroundColor="#E8EEF5"
                                    TextColor="{StaticResource Primary}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsActiveFilter}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding InactiveFilterLabel}"
                                    Command="{Binding SelectStatusCommand}"
                                    CommandParameter="deactive"
                                    Padding="14,8"
                                    FontSize="13"
                                    CornerRadius="18"
                                    MinimumHeightRequest="40"
                                    BackgroundColor="#E8EEF5"
                                    TextColor="{StaticResource Primary}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactiveFilter}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>
                    </ScrollView>
                    <SearchBar Placeholder="Search league name"
                               Text="{Binding NameFilter}"
                               CancelButtonColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </ctrl:FilterDrawer>

            <RefreshView Grid.Row="2"
                         IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                         Command="{Binding LoadCommand}">
                <CollectionView ItemsSource="{Binding Items}"
                                SelectionMode="None"
                                RemainingItemsThreshold="1"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.EmptyView>
                        <Label Text="{Binding EmptyText}"
                               Margin="0,24"
                               HorizontalTextAlignment="Center"
                               Style="{StaticResource MutedLabel}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ManagedLeagueRow">
                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,8">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border WidthRequest="52"
                                                HeightRequest="52"
                                                StrokeThickness="0"
                                                BackgroundColor="#E8EEF5"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding Image}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   LineBreakMode="TailTruncation"
                                                   Style="{StaticResource BodyLabel}" />
                                            <Label Text="{Binding MembersText}"
                                                   FontSize="12"
                                                   Style="{StaticResource MutedLabel}" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Border Padding="8,2"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{Binding StatusColor}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="9" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="White" />
                                                </Border>
                                                <Label Text="{Binding LiveText}"
                                                       IsVisible="{Binding HasLive}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Danger}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding CreatedText}"
                                                       FontSize="11"
                                                       Style="{StaticResource MutedLabel}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="8"
                                          IsVisible="{Binding CanWrite, Source={RelativeSource AncestorType={x:Type vm:LeagueManagementViewModel}}, x:DataType=vm:LeagueManagementViewModel}">
                                        <Button Text="{Binding ToggleActiveLabel}"
                                                Style="{StaticResource GhostButton}"
                                                HorizontalOptions="Fill"
                                                Clicked="OnToggleActiveClicked"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1"
                                                Text="Edit"
                                                Style="{StaticResource OutlineButton}"
                                                Padding="14,8"
                                                MinimumHeightRequest="40"
                                                FontSize="13"
                                                Clicked="OnEditClicked"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2"
                                                Text="Del"
                                                Style="{StaticResource DangerButton}"
                                                Padding="12,8"
                                                MinimumHeightRequest="40"
                                                FontSize="13"
                                                Opacity="{Binding DeleteOpacity}"
                                                Clicked="OnDeleteClicked"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <VerticalStackLayout Grid.Row="3" Spacing="4">
                <ActivityIndicator IsRunning="{Binding ShowSpinner}"
                                   IsVisible="{Binding ShowSpinner}"
                                   Color="{StaticResource Secondary}" />
                <Label Text="Deactivate a league before deleting it. Deleted leagues keep their data on the server."
                       FontSize="11"
                       Style="{StaticResource MutedLabel}" />
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Danger}"
                       FontSize="12" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
