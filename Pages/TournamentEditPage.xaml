<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:jpl="clr-namespace:JPL"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             x:Class="JPL.Pages.TournamentEditPage"
             x:Name="ThisPage"
             x:DataType="vm:TournamentEditViewModel"
             Title="{Binding PageTitle}"
             HideSoftInputOnTapped="True">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Setup" Style="{StaticResource SectionLabel}" />
                    <Entry Placeholder="Tournament name"
                           Text="{Binding Name}"
                           MaxLength="160" />

                    <Label Text="Type" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Picker Title="Tournament type"
                            ItemsSource="{Binding TypeOptions}"
                            SelectedItem="{Binding SelectedType}" />

                    <Label Text="Knockout" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Picker Title="Knockout format"
                            ItemsSource="{Binding KnockoutOptions}"
                            SelectedItem="{Binding SelectedKnockout}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowGroupPicker}">
                            <Label Text="Groups (1, 2 or 4)" FontSize="12" Style="{StaticResource MutedLabel}" />
                            <Picker ItemsSource="{Binding GroupOptions}"
                                    SelectedItem="{Binding GroupCount}"
                                    Title="Groups" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsCustom}">
                            <Label Text="Groups" FontSize="12" Style="{StaticResource MutedLabel}" />
                            <Border StrokeThickness="0"
                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="1 only (Custom)"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding ShowQualifyPicker}">
                            <Label Text="Qualify / group" FontSize="12" Style="{StaticResource MutedLabel}" />
                            <Picker ItemsSource="{Binding QualifyOptions}"
                                    SelectedItem="{Binding QualifyPerGroup}"
                                    Title="Qualify" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{Binding FormatHint}"
                           FontSize="12"
                           TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Match defaults *" Style="{StaticResource SectionLabel}" />
                    <Label Text="Applied to every fixture match (locked when starting)."
                           Style="{StaticResource MutedLabel}"
                           FontSize="12" />

                    <Label Text="Venue *" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Picker Title="Select venue"
                            ItemsSource="{Binding VenueOptions}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedVenue}" />

                    <Label Text="Format *" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Picker Title="Select format"
                            ItemsSource="{Binding FormatOptions}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedFormat}" />
                    <Label Text="{Binding OversHint}"
                           FontSize="12"
                           Style="{StaticResource MutedLabel}" />
                    <Label Text="Add formats in the Formats module. Tournament matches only pick one."
                           Style="{StaticResource MutedLabel}"
                           FontSize="12" />

                    <HorizontalStackLayout Spacing="12" jpl:ToggleOnTap.Enable="True">
                        <Switch IsToggled="{Binding LastBatsmanCanBatAsSingleWicket}"
                                VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Last batsman can bat as single wicket"
                                   FontAttributes="Bold"
                                   Style="{StaticResource BodyLabel}" />
                            <Label Text="Last remaining batsman continues alone."
                                   Style="{StaticResource MutedLabel}"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Label Text="Bowler maximum overs" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Entry Placeholder="0 = no limit"
                           Text="{Binding BowlerMaxOvers}"
                           Keyboard="Numeric" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Teams" Style="{StaticResource SectionLabel}" />
                    <Label Text="Select teams. With 2+ groups, tap Group to cycle G1 / G2 / G3 / G4."
                           Style="{StaticResource MutedLabel}"
                           FontSize="12" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TeamPicks}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TournamentTeamPick">
                                <Border StrokeThickness="0"
                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                        Padding="10,8"
                                        StrokeShape="RoundRectangle 10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TeamName}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Fill"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               jpl:ToggleOnTap.Enable="True" />
                                        <Label Grid.Column="2"
                                               Text="{Binding MatchLoadLabel}"
                                               Style="{StaticResource MutedLabel}"
                                               FontSize="11"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding BindingContext.IsCustom, Source={x:Reference ThisPage}, x:DataType={x:Null}}" />
                                        <Button Grid.Column="3"
                                                Text="{Binding GroupLabel}"
                                                Padding="10,4"
                                                FontSize="11"
                                                BackgroundColor="#E8EEF5"
                                                TextColor="{StaticResource Primary}"
                                                IsVisible="{Binding BindingContext.ShowGroup2, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                Command="{Binding BindingContext.ToggleGroupCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}"
                    Padding="14"
                    IsVisible="{Binding ShowCustomBuilder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Custom fixtures" Style="{StaticResource SectionLabel}" />
                    <Label Text="Choose Manual or Auto. Each team plays the matches-per-team count you pick. Auto can be run again for a different draw. Save schedule on the detail page only after fixtures are complete."
                           Style="{StaticResource MutedLabel}"
                           FontSize="12" />

                    <Label Text="Matches per team" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Picker Title="Matches per team"
                            ItemsSource="{Binding MatchesPerTeamOptions}"
                            SelectedItem="{Binding MatchesPerTeam}" />

                    <Label Text="Method" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Picker Title="Manual or Auto"
                            ItemsSource="{Binding CustomMethodOptions}"
                            SelectedItem="{Binding SelectedCustomMethod}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsCustomManual}">
                        <Label Text="Add fixture" FontSize="12" Style="{StaticResource MutedLabel}" />
                        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                            <Picker Title="Team A"
                                    ItemsSource="{Binding CustomTeamChoices}"
                                    ItemDisplayBinding="{Binding TeamName}"
                                    SelectedItem="{Binding PairTeamA}" />
                            <Label Grid.Column="1" Text="vs" VerticalOptions="Center" FontAttributes="Bold" />
                            <Picker Grid.Column="2"
                                    Title="Team B"
                                    ItemsSource="{Binding CustomTeamChoices}"
                                    ItemDisplayBinding="{Binding TeamName}"
                                    SelectedItem="{Binding PairTeamB}" />
                            <Button Grid.Column="3"
                                    Text="Add"
                                    Style="{StaticResource GoldButton}"
                                    Padding="12,8"
                                    Command="{Binding AddCustomPairCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsCustomAuto}">
                        <Label Text="Auto builds a full valid schedule. Tap again for a different draw."
                               Style="{StaticResource MutedLabel}"
                               FontSize="12" />
                        <Button Text="{Binding AutoGenerateButtonText}"
                                Style="{StaticResource GoldButton}"
                                HeightRequest="44"
                                Command="{Binding GenerateCustomFixturesCommand}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding CustomPairingHint}"
                           FontSize="12"
                           TextColor="{StaticResource Primary}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CustomPairs}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TournamentCustomPairDraft">
                                <Border StrokeThickness="0"
                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                        Padding="10,8"
                                        StrokeShape="RoundRectangle 10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Label}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                        <Button Grid.Column="1"
                                                Text="Remove"
                                                Padding="10,6"
                                                FontSize="12"
                                                BackgroundColor="#FFE8EC"
                                                TextColor="{StaticResource Danger}"
                                                IsVisible="{Binding BindingContext.IsCustomManual, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                Command="{Binding BindingContext.RemoveCustomPairCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
            <Button Text="Save as draft"
                    Style="{StaticResource GoldButton}"
                    HeightRequest="48"
                    Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
