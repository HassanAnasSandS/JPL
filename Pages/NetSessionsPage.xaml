<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.NetSessionsPage"
             x:DataType="vm:NetSessionsViewModel"
             Title="Nets Practice"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="14" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Sessions"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{StaticResource Primary}" />
            <Button Grid.Column="1"
                    Text="{Binding AddButtonText}"
                    Style="{StaticResource GoldButton}"
                    Padding="16,10"
                    IsVisible="{Binding CanWrite}"
                    Clicked="OnAddClicked" />
        </Grid>

        <ctrl:FilterDrawer Grid.Row="1"
                           HasActiveFilters="{Binding HasActiveFilters}"
                           ClearCommand="{Binding ClearFiltersCommand}">
            <VerticalStackLayout Spacing="8">
                <SearchBar Placeholder="Filter by session name"
                           Text="{Binding NameFilter}"
                           CancelButtonColor="{StaticResource Primary}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding FilterByDate}" VerticalOptions="Center" />
                        <Label Text="By date" VerticalOptions="Center" Style="{StaticResource BodyLabel}" />
                    </HorizontalStackLayout>
                    <DatePicker Grid.Column="1"
                                Date="{Binding FilterDate}"
                                IsEnabled="{Binding FilterByDate}"
                                VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </ctrl:FilterDrawer>

        <Border Grid.Row="2"
                IsVisible="{Binding HasActiveSession}"
                StrokeThickness="0"
                BackgroundColor="#FFE8EC"
                Padding="12,10"
                StrokeShape="RoundRectangle 10">
            <Label Text="{Binding ActiveSessionHint}"
                   FontSize="12"
                   TextColor="{StaticResource Danger}" />
        </Border>

        <RefreshView Grid.Row="3"
                     VerticalOptions="Fill"
                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            VerticalOptions="Fill">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">
                        <Label Text="No nets sessions yet"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Start a session with a name and participating players"
                               Style="{StaticResource MutedLabel}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:NetSessionListItem">
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="10"
                                  ColumnSpacing="10">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="17"
                                       LineBreakMode="TailTruncation"
                                       Style="{StaticResource BodyLabel}" />
                                <Border Grid.Column="1"
                                        Padding="10,4"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding StatusText}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Secondary}" />
                                </Border>

                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding ScoreText}"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />

                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding MetaLine}"
                                       Style="{StaticResource MutedLabel}" />

                                <Grid Grid.Row="3"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8">
                                    <Button Text="{Binding ActionLabel}"
                                            Style="{StaticResource GoldButton}"
                                            HorizontalOptions="Fill"
                                            Clicked="OnScoreClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1"
                                            Text="Sync"
                                            Style="{StaticResource GoldButton}"
                                            Padding="14,8"
                                            IsVisible="{Binding NeedsSync}"
                                            Clicked="OnSyncClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2"
                                            Text="Del"
                                            Style="{StaticResource DangerButton}"
                                            Padding="14,8"
                                            IsVisible="{Binding CanDelete}"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="4"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />
    </Grid>
</ContentPage>
