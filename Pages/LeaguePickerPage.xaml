<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.LeaguePickerPage"
             x:Name="ThisPage"
             x:DataType="vm:LeaguePickerViewModel"
             Title="Choose league"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D1B2A">

    <Grid>
    <Grid Padding="20,32" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="14">
        <Grid>
            <Image Source="cric360_logo.png"
                   HeightRequest="110"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Cric360 logo" />
            <Button Text="Home"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="16,10"
                    BackgroundColor="Transparent"
                    TextColor="#B6FF3B"
                    BorderColor="#B6FF3B"
                    BorderWidth="1.5"
                    CornerRadius="12"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"
                    Command="{Binding HomeCommand}" />
            <Button Text="+ Add"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="16,10"
                    BackgroundColor="#B6FF3B"
                    TextColor="#0D1B2A"
                    CornerRadius="12"
                    VerticalOptions="Start"
                    HorizontalOptions="End"
                    IsVisible="{Binding CanManageLeagues}"
                    Command="{Binding AddCommand}" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="CRIC360"
                   TextColor="#B6FF3B"
                   FontAttributes="Bold"
                   FontSize="22"
                   HorizontalTextAlignment="Center"
                   CharacterSpacing="2" />
            <ctrl:SloganTicker TextColor="#B8C4D4"
                               FontSize="12"
                               IntervalMs="3200" />
            <Label Text="{Binding PickerSubtitle}"
                   TextColor="#B8C4D4"
                   FontSize="14"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                     Command="{Binding LoadCommand}">
            <ScrollView>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LeaguePickRow">
                        <Border StrokeThickness="0"
                                BackgroundColor="#152033"
                                Padding="12"
                                Margin="0,0,0,10"
                                StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsHome}" Value="True">
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="Stroke" Value="#D4AF37" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                                    <Image Source="{Binding Image}"
                                           HeightRequest="64"
                                           WidthRequest="64"
                                           Aspect="AspectFill" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="18"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation" />
                                            <Border StrokeThickness="0"
                                                    BackgroundColor="#D4AF37"
                                                    Padding="8,3"
                                                    StrokeShape="RoundRectangle 8"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding HasBadge}">
                                                <Label Text="{Binding Badge}"
                                                       TextColor="#0D1B2A"
                                                       FontAttributes="Bold"
                                                       FontSize="10" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Border StrokeThickness="0"
                                                BackgroundColor="#C62828"
                                                Padding="8,3"
                                                StrokeShape="RoundRectangle 8"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding HasLive}">
                                            <Label Text="{Binding LiveTag}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="11" />
                                        </Border>
                                        <Label Text="{Binding Hint}"
                                               TextColor="#8899AA"
                                               FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>

                                <HorizontalStackLayout Spacing="8"
                                                       IsVisible="{Binding BindingContext.CanManageLeagues, Source={x:Reference ThisPage}, x:DataType={x:Null}}">
                                    <Button Text="View"
                                            Padding="14,8"
                                            FontSize="12"
                                            BackgroundColor="#243447"
                                            TextColor="#B6FF3B"
                                            Command="{Binding BindingContext.SelectCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Edit"
                                            Padding="14,8"
                                            FontSize="12"
                                            BackgroundColor="#D4AF37"
                                            TextColor="#0D1B2A"
                                            Command="{Binding BindingContext.EditCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Delete"
                                            Padding="14,8"
                                            FontSize="12"
                                            BackgroundColor="#B00020"
                                            TextColor="White"
                                            Command="{Binding BindingContext.DeleteCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               TextColor="#FF6B6B"
               FontSize="13"
               HorizontalTextAlignment="Center" />

        <VerticalStackLayout Grid.Row="4" Spacing="10">
            <Button Text="Register Your Own League"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="48"
                    BackgroundColor="#D4AF37"
                    TextColor="#0D1B2A"
                    CornerRadius="12"
                    IsVisible="{Binding ShowRegisterLeague}"
                    Command="{Binding OpenRegisterPopupCommand}" />
            <Button Text="Logout"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="48"
                    BackgroundColor="#B00020"
                    TextColor="White"
                    CornerRadius="12"
                    Command="{Binding LogoutCommand}" />
        </VerticalStackLayout>
    </Grid>

    <!-- Register-league contact (everyone except HassanAnas SuperAdmin) -->
    <Grid IsVisible="{Binding ShowRegisterPopup}" ZIndex="40">
        <BoxView Color="#E60D1B2A">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseRegisterPopupCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border StrokeThickness="0"
                BackgroundColor="#152033"
                Padding="22"
                Margin="24"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                StrokeShape="RoundRectangle 18">
            <ScrollView MaximumHeightRequest="560">
            <VerticalStackLayout Spacing="12">
                <Label Text="Launch Your League on Cric360"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#D4AF37"
                       LineBreakMode="WordWrap" />
                <Label Text="Give your cricket a professional home. Cric360 delivers live scoring, scorecards, player stats, and branded league identity — so every match looks as good as it plays."
                       FontSize="14"
                       TextColor="#E8EEF5"
                       LineBreakMode="WordWrap" />
                <Label Text="Share your league name and logo. Our team will set you up and take you live."
                       FontSize="13"
                       TextColor="#B8C4D4"
                       LineBreakMode="WordWrap" />

                <Border StrokeThickness="0"
                        BackgroundColor="#0F1A28"
                        Padding="14"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding WhatsAppRegisterCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="WhatsApp"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#8899AA" />
                            <Label Text="0322 2857730"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#B6FF3B" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EmailRegisterCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Email"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#8899AA" />
                            <Label Text="official.cric360@gmail.com"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#B6FF3B"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FacebookRegisterCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Facebook"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#8899AA" />
                            <Label Text="Official.Cric360"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#B6FF3B" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InstagramRegisterCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Instagram"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#8899AA" />
                            <Label Text="@official.cric360"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#B6FF3B" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TikTokRegisterCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="TikTok"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#8899AA" />
                            <Label Text="@official.cric360"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#B6FF3B" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding YouTubeRegisterCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="YouTube"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#8899AA" />
                            <Label Text="cric360 Cricket Scoring"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#B6FF3B"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="#243447"
                        Padding="12"
                        StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Introductory offer"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#D4AF37" />
                        <Label Text="Registration is free for the first 6 months. After that, continue with a monthly or yearly subscription."
                               FontSize="13"
                               TextColor="#B8C4D4"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="WhatsApp Cric360"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="46"
                        BackgroundColor="#25D366"
                        TextColor="White"
                        CornerRadius="12"
                        Command="{Binding WhatsAppRegisterCommand}" />
                <Button Text="Email Cric360"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        BackgroundColor="#243447"
                        TextColor="#B6FF3B"
                        CornerRadius="12"
                        Command="{Binding EmailRegisterCommand}" />
                <Button Text="Facebook — Official.Cric360"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        BackgroundColor="#1877F2"
                        TextColor="White"
                        CornerRadius="12"
                        Command="{Binding FacebookRegisterCommand}" />
                <Button Text="Instagram — @official.cric360"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        BackgroundColor="#C13584"
                        TextColor="White"
                        CornerRadius="12"
                        Command="{Binding InstagramRegisterCommand}" />
                <Button Text="TikTok — @official.cric360"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        BackgroundColor="#111111"
                        TextColor="White"
                        CornerRadius="12"
                        Command="{Binding TikTokRegisterCommand}" />
                <Button Text="YouTube — cric360 Cricket Scoring"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        BackgroundColor="#FF0000"
                        TextColor="White"
                        CornerRadius="12"
                        Command="{Binding YouTubeRegisterCommand}" />
                <Button Text="Close"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        BackgroundColor="Transparent"
                        TextColor="#B8C4D4"
                        BorderColor="#5A6A7A"
                        BorderWidth="1"
                        CornerRadius="12"
                        Command="{Binding CloseRegisterPopupCommand}" />
            </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
