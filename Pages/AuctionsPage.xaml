<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             x:Class="JPL.Pages.AuctionsPage"
             x:Name="ThisPage"
             x:DataType="vm:AuctionsViewModel"
             Title="Auctions"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto,*,Auto" Padding="14" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label Text="Auctions"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{StaticResource Primary}" />
            <Button Grid.Column="1"
                    Text="Report"
                    Padding="14,10"
                    BackgroundColor="#E8EEF5"
                    TextColor="{StaticResource Primary}"
                    Clicked="OnReportClicked" />
            <Button Grid.Column="2"
                    Text="+ Add"
                    Style="{StaticResource GoldButton}"
                    Padding="16,10"
                    IsVisible="{Binding CanWrite}"
                    Clicked="OnAddClicked" />
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            EmptyView="No auctions yet. Create First Auction to begin.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:AuctionListItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding AuctionDateUtc, StringFormat='{0:dd MMM yyyy}'}"
                                               Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding TotalSoldAmount, StringFormat='{0:N0}'}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </Grid>
                                <Label Text="{Binding CaptainCount, StringFormat='Captains: {0}'}"
                                       FontSize="12"
                                       Style="{StaticResource MutedLabel}" />
                                <Label FontSize="12" Style="{StaticResource MutedLabel}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Players {0} · Sold {1} · Unsold {2}">
                                            <Binding Path="PlayerCount" />
                                            <Binding Path="SoldCount" />
                                            <Binding Path="UnsoldCount" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="View"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#E8EEF5"
                                            TextColor="{StaticResource Primary}"
                                            Clicked="OnViewClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Edit"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            IsVisible="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CanWrite}"
                                            Clicked="OnEditClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Delete"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource DangerButton}"
                                            IsVisible="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CanWrite}"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />
    </Grid>
</ContentPage>
