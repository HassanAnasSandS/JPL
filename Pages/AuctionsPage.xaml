<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             x:Class="JPL.Pages.AuctionsPage"
             x:Name="ThisPage"
             x:DataType="vm:AuctionsViewModel"
             Title="Auction/Drafting"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto,*,Auto" Padding="{OnIdiom Phone=14, Default=10}" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Auction/Drafting"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{Binding CountLabel}"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Report"
                    Padding="14,10"
                    BackgroundColor="#E8EEF5"
                    TextColor="{StaticResource Primary}"
                    Clicked="OnReportClicked" />
            <Button Grid.Column="2"
                    Text="+ Add"
                    Style="{StaticResource GoldButton}"
                    Padding="16,10"
                    IsVisible="{Binding CanWrite}"
                    Clicked="OnAddClicked" />
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView x:Name="AuctionsList"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            RemainingItemsThreshold="1"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            EmptyView="No Auction/Drafting yet. Create first Auction/Drafting to begin.">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="AuctionsGridLayout"
                                     Orientation="Vertical"
                                     Span="1"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:AuctionListItem">
                        <Border Style="{StaticResource CardBorder}" Padding="{OnIdiom Phone=14, Default=12}"
                                HorizontalOptions="Fill" VerticalOptions="Fill">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="{StaticResource Primary}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding AuctionDateUtc, StringFormat='{0:dd MMM yyyy}'}"
                                               Style="{StaticResource MutedLabel}" />
                                        <Label FontSize="11" TextColor="{StaticResource Secondary}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="KindLabel" />
                                                    <Binding Path="ModeLabel" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding TotalSoldAmount, StringFormat='{0:N0}'}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </Grid>
                                <Label FontSize="12" Style="{StaticResource MutedLabel}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Captains {0} · Players {1} · Sold {2} · Unsold {3}">
                                            <Binding Path="CaptainCount" />
                                            <Binding Path="PlayerCount" />
                                            <Binding Path="SoldCount" />
                                            <Binding Path="UnsoldCount" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <FlexLayout Wrap="Wrap" AlignItems="Start" JustifyContent="Start">
                                    <Button Text="View"
                                            Margin="0,0,6,4"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#E8EEF5"
                                            TextColor="{StaticResource Primary}"
                                            Clicked="OnViewClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Enter"
                                            Margin="0,0,6,4"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            IsVisible="{Binding CanEnterAsCaptain}"
                                            Clicked="OnEnterClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Run"
                                            Margin="0,0,6,4"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            IsVisible="{Binding CanEditSetup}"
                                            Clicked="OnEditClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Delete"
                                            Margin="0,0,6,4"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource DangerButton}"
                                            IsVisible="{Binding CanDelete}"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding .}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />
    </Grid>
</ContentPage>
