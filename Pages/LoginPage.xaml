<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Cric360 Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D1B2A"
             HideSoftInputOnTapped="True">

    <Grid>
    <!-- ScrollView content is sized to viewport so the form can center on screen. -->
    <ScrollView x:Name="LoginScroll"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never"
                SizeChanged="OnLoginScrollSizeChanged"
                IsEnabled="{Binding IsFormEnabled}">
        <Grid x:Name="ContentHost"
              Padding="28,40"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <VerticalStackLayout Spacing="16"
                                 WidthRequest="360"
                                 MaximumWidthRequest="420"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Image Source="cric360_logo.png"
                       HeightRequest="140"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="Cric360 logo" />

                <Label Text="CRIC360"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#B6FF3B"
                       FontSize="18"
                       FontAttributes="Bold"
                       CharacterSpacing="2" />
                <ctrl:SloganTicker TextColor="#B8C4D4"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   IntervalMs="3200" />

                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowLoginForm}">
                    <Border StrokeThickness="0"
                            BackgroundColor="#152033"
                            Padding="16"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="12">
                            <Entry Placeholder="Username"
                                   Text="{Binding Username}"
                                   ReturnType="Next"
                                   TextColor="White"
                                   PlaceholderColor="#8899AA"
                                   BackgroundColor="Transparent" />
                            <BoxView HeightRequest="1" Color="#2A3A4E" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Entry Placeholder="Password"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       ReturnType="Go"
                                       ReturnCommand="{Binding LoginCommand}"
                                       TextColor="White"
                                       PlaceholderColor="#8899AA"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding PasswordToggleIcon}"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#8899AA"
                                        FontSize="18"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        Padding="0"
                                        BorderWidth="0"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="Show or hide password" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="Login"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource GoldButton}"
                            HeightRequest="52"
                            FontSize="16" />
                    <Button Text="Sign up"
                            Command="{Binding ToggleSignupCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#B6FF3B"
                            BorderColor="#B6FF3B"
                            BorderWidth="1.5"
                            HeightRequest="52"
                            FontSize="15"
                            CornerRadius="12" />
                    <Button Text="Continue Without Login"
                            Command="{Binding ContinueWithoutLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#B6FF3B"
                            BorderColor="#B6FF3B"
                            BorderWidth="1.5"
                            HeightRequest="52"
                            FontSize="15"
                            CornerRadius="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowSignupForm}">
                    <Border StrokeThickness="0"
                            BackgroundColor="#152033"
                            Padding="16"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="12">
                            <Entry Placeholder="Name *"
                                   Text="{Binding Username}"
                                   ReturnType="Next"
                                   TextColor="White"
                                   PlaceholderColor="#8899AA"
                                   BackgroundColor="Transparent" />
                            <BoxView HeightRequest="1" Color="#2A3A4E" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Entry Placeholder="Password *"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       ReturnType="Next"
                                       TextColor="White"
                                       PlaceholderColor="#8899AA"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding PasswordToggleIcon}"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#8899AA"
                                        FontSize="18"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        Padding="0"
                                        BorderWidth="0"
                                        VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#2A3A4E" />
                            <Entry Placeholder="WhatsApp * (03XX XXXXXXX)"
                                   Text="{Binding WhatsApp}"
                                   Keyboard="Telephone"
                                   MaxLength="16"
                                   ReturnType="Go"
                                   ReturnCommand="{Binding SignupCommand}"
                                   TextColor="White"
                                   PlaceholderColor="#8899AA"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="Create account"
                            Command="{Binding SignupCommand}"
                            Style="{StaticResource GoldButton}"
                            HeightRequest="52"
                            FontSize="16" />
                    <Button Text="Back to Login"
                            Command="{Binding ToggleSignupCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#B6FF3B"
                            BorderColor="#B6FF3B"
                            BorderWidth="1.5"
                            HeightRequest="52"
                            FontSize="15"
                            CornerRadius="12" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding IsFormEnabled}"
                       TextColor="#FF6B6B"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="13" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
    </Grid>
</ContentPage>
