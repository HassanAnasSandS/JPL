<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.VenueBookingsPage"
             x:Name="ThisPage"
             x:DataType="vm:VenueBookingsViewModel"
             Title="Venue Bookings"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="Venue Bookings"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{StaticResource Primary}" />
            <Button Grid.Column="1"
                    Text="+ Add"
                    Style="{StaticResource GoldButton}"
                    Padding="16,10"
                    IsVisible="{Binding CanWrite}"
                    Clicked="OnAddClicked" />
        </Grid>

        <ctrl:FilterDrawer Grid.Row="1"
                           HasActiveFilters="{Binding HasFilter}"
                           ClearCommand="{Binding ClearFilterCommand}">
            <SearchBar Placeholder="Filter venue / player / admin"
                       Text="{Binding NameFilter}"
                       CancelButtonColor="{StaticResource Primary}" />
        </ctrl:FilterDrawer>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            EmptyView="No venue bookings yet.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VenueBookingRow">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding VenueName}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding DateText}"
                                               Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding CostText}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </Grid>
                                <Label Text="{Binding BookedByLine}" FontSize="12" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding ParticipantsLine}" FontSize="12" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding OwnerLine}" FontSize="12" TextColor="{StaticResource Primary}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="View"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#E8EEF5"
                                            TextColor="{StaticResource Primary}"
                                            Clicked="OnViewClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Edit"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            IsVisible="{Binding CanEdit}"
                                            Clicked="OnEditClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Delete"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource DangerButton}"
                                            IsVisible="{Binding CanEdit}"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="3" Spacing="4">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Secondary}" />
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Danger}"
                   FontSize="12" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
