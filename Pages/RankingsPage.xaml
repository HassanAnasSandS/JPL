<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.RankingsPage"
             x:Name="ThisPage"
             x:DataType="vm:RankingsViewModel"
             Title="Rankings"
             HideSoftInputOnTapped="True">

    <ContentPage.Resources>
        <Style x:Key="RankTab" TargetType="Button">
            <Setter Property="FontSize" Value="{OnIdiom Phone=11, Default=12}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=30, Default=36}" />
            <Setter Property="BackgroundColor" Value="#E8EEF5" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="Padding">
                <Setter.Value>
                    <OnIdiom x:TypeArguments="Thickness" Phone="8,4" Default="12,6" />
                </Setter.Value>
            </Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E8C84A" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#D4AF37" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                <Setter Property="Scale" Value="0.96" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
    <Grid Padding="{OnIdiom Phone=8, Default=14}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="{OnIdiom Phone=6, Default=10}">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Rankings"
                       FontSize="{OnIdiom Phone=18, Default=22}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{x:Static svc:BrandSlogans.Statistics}"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Label Grid.Column="1"
                   VerticalOptions="End"
                   Text="{Binding CountLabel}"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}" />
        </Grid>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6">
                <ctrl:TabChipButton Text="Batting"
                        Style="{StaticResource RankTab}"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="batting">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBatting}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </ctrl:TabChipButton>
                <ctrl:TabChipButton Text="Bowling"
                        Style="{StaticResource RankTab}"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="bowling">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBowling}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </ctrl:TabChipButton>
                <ctrl:TabChipButton Text="All-Rounder"
                        Style="{StaticResource RankTab}"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="allrounder">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAllRounder}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </ctrl:TabChipButton>
                <ctrl:TabChipButton Text="Fielder"
                        Style="{StaticResource RankTab}"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="fielder">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsFielder}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </ctrl:TabChipButton>
                <ctrl:TabChipButton Text="Captain"
                        Style="{StaticResource RankTab}"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="captain">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsCaptain}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </ctrl:TabChipButton>
                <ctrl:TabChipButton Text="Team"
                        Style="{StaticResource RankTab}"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="team">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTeam}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </ctrl:TabChipButton>
            </HorizontalStackLayout>
        </ScrollView>

        <ctrl:FilterDrawer Grid.Row="2"
                           HasActiveFilters="{Binding HasActiveFilters}"
                           ClearCommand="{Binding ClearFiltersCommand}"
                           ApplyCommand="{Binding ApplyDateRangeCommand}"
                           ApplyButtonText="Apply">
            <VerticalStackLayout Spacing="{OnIdiom Phone=4, Default=8}">
                <SearchBar Placeholder="{Binding SearchPlaceholder}"
                           Text="{Binding NameFilter}"
                           CancelButtonColor="{StaticResource Primary}" />
                <ctrl:FormatMultiSelectView BindingContext="{Binding FormatFilter}" />
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                    <Label Text="From"
                           VerticalOptions="Center"
                           Style="{StaticResource MutedLabel}" />
                    <DatePicker Grid.Column="1"
                                Date="{Binding FromDate}"
                                Format="dd MMM yyyy" />
                    <Label Grid.Column="2"
                           Text="To"
                           VerticalOptions="Center"
                           Style="{StaticResource MutedLabel}" />
                    <DatePicker Grid.Column="3"
                                Date="{Binding ToDate}"
                                Format="dd MMM yyyy" />
                </Grid>
            </VerticalStackLayout>
        </ctrl:FilterDrawer>

        <VerticalStackLayout Grid.Row="3" Spacing="2">
            <Label Text="{Binding CategoryTitle}"
                   FontAttributes="Bold"
                   FontSize="{OnIdiom Phone=13, Default=16}"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="{StaticResource Danger}"
                   FontSize="12" />
        </VerticalStackLayout>

        <Grid Grid.Row="4" RowDefinitions="Auto,*" VerticalOptions="Fill">
            <Grid HeightRequest="42"
                  Padding="{OnIdiom Phone=8, Default=10}"
                  ColumnDefinitions="40,*,Auto"
                  ColumnSpacing="{OnIdiom Phone=8, Default=10}"
                  BackgroundColor="{StaticResource Primary}">
                <Label Text="#"
                       FontAttributes="Bold"
                       FontSize="12"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Secondary}" />
                <Label Grid.Column="1"
                       Text="{Binding NameColumnTitle}"
                       FontAttributes="Bold"
                       FontSize="12"
                       VerticalOptions="Center"
                       TextColor="{StaticResource Secondary}" />
                <Label Grid.Column="2"
                       Text="Pts"
                       FontAttributes="Bold"
                       FontSize="12"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="End"
                       TextColor="{StaticResource Secondary}" />
            </Grid>
        <RefreshView Grid.Row="1"
                     VerticalOptions="Fill"
                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding VisibleRows}"
                            SelectionMode="None"
                            VerticalOptions="Fill"
                            RemainingItemsThreshold="1"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">
                        <Label Text="No rankings yet"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Complete matches and pull to refresh"
                               Style="{StaticResource MutedLabel}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="{OnIdiom Phone=5, Default=8}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:RankingRow">
                        <Border Style="{StaticResource CardBorder}" Padding="{OnIdiom Phone=8, Default=10}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenBreakdownCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="40,*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="{OnIdiom Phone=8, Default=10}"
                                  RowSpacing="4">
                                <Border Grid.RowSpan="2"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="{OnIdiom Phone=32, Default=40}"
                                        HeightRequest="{OnIdiom Phone=32, Default=40}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding RankText}"
                                           FontAttributes="Bold"
                                           FontSize="{OnIdiom Phone=11, Default=13}"
                                           TextColor="{StaticResource Secondary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding PlayerName}"
                                       FontAttributes="Bold"
                                       FontSize="{OnIdiom Phone=13, Default=15}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"
                                       TextColor="#1565C0" />

                                <Label Grid.Column="2"
                                       Grid.RowSpan="2"
                                       Text="{Binding PrimaryLine}"
                                       FontAttributes="Bold"
                                       FontSize="{OnIdiom Phone=12, Default=14}"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"
                                       TextColor="{StaticResource Primary}" />

                                <ctrl:RankBarView Grid.Row="1"
                                                  Grid.Column="1"
                                                  Ratio="{Binding BarRatio}"
                                                  FillColor="{Binding BarColor}"
                                                  HorizontalOptions="Fill"
                                                  VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        </Grid>
    </Grid>

        <Grid IsVisible="{Binding IsBreakdownVisible}"
              InputTransparent="False"
              ZIndex="40">
            <BoxView Color="#99000000"
                     InputTransparent="False"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseBreakdownCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2838}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16"
                    Margin="18"
                    VerticalOptions="Center"
                    MaximumWidthRequest="460"
                    MaximumHeightRequest="640"
                    HorizontalOptions="Center">
                <Grid RowDefinitions="Auto,* ,Auto" RowSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding BreakdownRank}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                        <Label Text="{Binding BreakdownName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding Breakdown.Title}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding Breakdown.NetText}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding Breakdown.Formula}"
                               FontSize="11"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="1"
                                VerticalScrollBarVisibility="Default">
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="6"
                                                 IsVisible="{Binding HasPositiveFactors}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Earned"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#15803D" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Breakdown.PositiveTotalText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#15803D" />
                                </Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Breakdown.Positive}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:RankingFactorLine">
                                            <Border StrokeThickness="0"
                                                    BackgroundColor="#EAF7EE"
                                                    Padding="10,8"
                                                    StrokeShape="RoundRectangle 10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <VerticalStackLayout Spacing="1">
                                                        <Label Text="{Binding Label}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}" />
                                                        <Label Text="{Binding Stat}"
                                                               FontSize="11"
                                                               LineBreakMode="WordWrap"
                                                               TextColor="{StaticResource TextSecondary}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding PointsText}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"
                                                           TextColor="{Binding PointsColor}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6"
                                                 IsVisible="{Binding HasNegativeFactors}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Negative / shortfall"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#C62828" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Breakdown.NegativeTotalText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#C62828" />
                                </Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Breakdown.Negative}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="svc:RankingFactorLine">
                                            <Border StrokeThickness="0"
                                                    BackgroundColor="#FDECEC"
                                                    Padding="10,8"
                                                    StrokeShape="RoundRectangle 10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <VerticalStackLayout Spacing="1">
                                                        <Label Text="{Binding Label}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}" />
                                                        <Label Text="{Binding Stat}"
                                                               FontSize="11"
                                                               LineBreakMode="WordWrap"
                                                               TextColor="{StaticResource TextSecondary}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding PointsText}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"
                                                           TextColor="{Binding PointsColor}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Label Text="{Binding Breakdown.Note}"
                                   FontSize="11"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasBreakdownNote}"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout Grid.Row="2" Spacing="8">
                        <Button Text="{Binding BreakdownCareerLabel}"
                                Style="{StaticResource GoldButton}"
                                IsVisible="{Binding CanOpenCareer}"
                                Command="{Binding OpenCareerCommand}" />
                        <Button Text="Close"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CloseBreakdownCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
