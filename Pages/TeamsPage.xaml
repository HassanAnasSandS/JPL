<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:vm="clr-namespace:JPL.ViewModels"

             xmlns:svc="clr-namespace:JPL.Services"

             xmlns:ctrl="clr-namespace:JPL.Controls"

             x:Class="JPL.Pages.TeamsPage"
             x:Name="ThisPage"
             x:DataType="vm:TeamsViewModel"

             Title="Teams"

             HideSoftInputOnTapped="True">



    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14" RowSpacing="10">

        <Grid ColumnDefinitions="*,Auto">

            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Clubs"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{x:Static svc:BrandSlogans.Catalog}"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />
                <Label Text="{Binding CountLabel}"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Button Grid.Column="1"

                    Text="+ Add"

                    Style="{StaticResource GoldButton}"

                    Padding="16,10"

                    IsVisible="{Binding CanWrite}"

                    Clicked="OnAddClicked" />

        </Grid>



                <ctrl:FilterDrawer Grid.Row="1"
                           HasActiveFilters="{Binding HasActiveFilters}"
                           ClearCommand="{Binding ClearFiltersCommand}">
            <VerticalStackLayout Spacing="8">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{Binding AllFilterLabel}"
                                Command="{Binding SelectStatusCommand}"
                                CommandParameter="all"
                                Padding="14,8"
                                FontSize="13"
                                CornerRadius="18"
                                MinimumHeightRequest="40"
                                BackgroundColor="#E8EEF5"
                                TextColor="{StaticResource Primary}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsAllFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{Binding ActiveFilterLabel}"
                                Command="{Binding SelectStatusCommand}"
                                CommandParameter="active"
                                Padding="14,8"
                                FontSize="13"
                                CornerRadius="18"
                                MinimumHeightRequest="40"
                                BackgroundColor="#E8EEF5"
                                TextColor="{StaticResource Primary}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsActiveFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{Binding InactiveFilterLabel}"
                                Command="{Binding SelectStatusCommand}"
                                CommandParameter="deactive"
                                Padding="14,8"
                                FontSize="13"
                                CornerRadius="18"
                                MinimumHeightRequest="40"
                                BackgroundColor="#E8EEF5"
                                TextColor="{StaticResource Primary}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsInactiveFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </ScrollView>
                <SearchBar Placeholder="Filter by team name"
                           Text="{Binding NameFilter}"
                           CancelButtonColor="{StaticResource Primary}" />
                <SearchBar Placeholder="Filter by captain"
                           Text="{Binding CaptainFilter}"
                           CancelButtonColor="{StaticResource Primary}" />
            </VerticalStackLayout>
        </ctrl:FilterDrawer>

<RefreshView Grid.Row="2"

                     VerticalOptions="Fill"

                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"

                     Command="{Binding LoadCommand}">

            <CollectionView ItemsSource="{Binding Items}"

                            SelectionMode="None"

                            VerticalOptions="Fill"

                            RemainingItemsThreshold="1"

                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                <CollectionView.EmptyView>

                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">

                        <Label Text="No teams found"

                               FontSize="16"

                               FontAttributes="Bold"

                               HorizontalOptions="Center"

                               TextColor="{StaticResource TextPrimary}" />

                        <Label Text="Try clearing filters, or add a team"

                               Style="{StaticResource MutedLabel}"

                               HorizontalOptions="Center"

                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="svc:TeamListItem">

                        <Border Style="{StaticResource CardBorder}">

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">

                                        <ctrl:RoundedPhotoView Photo="{Binding Photo}"

                                                               Initials="{Binding Initials}" />

                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">

                                        <Label Text="{Binding Name}"

                                               FontAttributes="Bold"

                                               FontSize="17"

                                               Style="{StaticResource BodyLabel}" />

                                        <Label Text="{Binding CaptainLine}"

                                               FontAttributes="Bold"

                                               TextColor="{StaticResource Secondary}" />

                                        <Label Text="{Binding StatusText}"

                                               FontSize="12"

                                               FontAttributes="Bold"

                                               TextColor="{Binding StatusColor}" />

                                        </VerticalStackLayout>

                                    </HorizontalStackLayout>

                                    <Border Grid.Column="1"

                                            Padding="10,4"

                                            StrokeThickness="0"

                                            BackgroundColor="{StaticResource SurfaceMuted}"

                                            StrokeShape="RoundRectangle 12"

                                            VerticalOptions="Center">

                                        <Label Text="{Binding PlayersLine}"

                                               FontSize="11"

                                               FontAttributes="Bold"

                                               TextColor="{StaticResource Primary}" />

                                    </Border>

                                </Grid>



                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">

                                    <Button Text="{Binding ToggleActiveLabel}"

                                            Style="{StaticResource GhostButton}"

                                            HorizontalOptions="Fill"

                                            IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"

                                            Clicked="OnToggleActiveClicked"

                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="1"

                                            Text="View"

                                            Style="{StaticResource OutlineButton}"

                                            Padding="14,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            Clicked="OnViewClicked"

                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="2"

                                            Text="Edit"

                                            Style="{StaticResource OutlineButton}"

                                            Padding="14,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"

                                            Clicked="OnEditClicked"

                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="3"

                                            Text="Del"

                                            Style="{StaticResource DangerButton}"

                                            Padding="12,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"

                                            Clicked="OnDeleteClicked"

                                            CommandParameter="{Binding .}" />

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>



        <Label Grid.Row="3"

               Text="{Binding ErrorMessage}"

               TextColor="{StaticResource Danger}"

               FontSize="12" />

    </Grid>

</ContentPage>


