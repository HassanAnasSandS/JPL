<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             x:Class="JPL.Pages.TournamentSchedulerDetailPage"
             x:Name="ThisPage"
             x:DataType="vm:TournamentSchedulerDetailViewModel"
             Title="Scheduler"
             HideSoftInputOnTapped="True">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="12" Spacing="10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding Name}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                    Padding="10,5"
                                    StrokeShape="RoundRectangle 8"
                                    VerticalOptions="Center">
                                <Label Text="{Binding StatusText}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding MetaLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                        <Label Text="{Binding WinnerLine}"
                               IsVisible="{Binding HasWinner}"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{StaticResource Secondary}" />
                        <Button Text="Edit setup"
                                IsVisible="{Binding CanEdit}"
                                Padding="12,8"
                                FontSize="12"
                                Style="{StaticResource GhostButton}"
                                HorizontalOptions="Start"
                                Command="{Binding EditCommand}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasStandings}">
                        <Label Text="Points table" Style="{StaticResource SectionLabel}" />
                        <Label Text="Won = 2 · Tied = 1 · Loss = 0"
                               Style="{StaticResource MutedLabel}"
                               FontSize="11"
                               Margin="0,-6,0,0" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding StandingGroups}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SchedulerStandingGroup">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Title}"
                                               IsVisible="{Binding ShowTitle}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               Margin="0,0,0,6"
                                               TextColor="{StaticResource Primary}" />
                                        <Grid ColumnDefinitions="28,*,28,28,28,28,36"
                                              ColumnSpacing="2"
                                              Padding="6,6"
                                              BackgroundColor="{StaticResource Primary}">
                                            <Label Text="#" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="1" Text="Team" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                            <Label Grid.Column="2" Text="P" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="3" Text="W" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="4" Text="L" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="5" Text="T" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="6" Text="Pts" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                        </Grid>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="svc:SchedulerStandingRow">
                                                    <Grid ColumnDefinitions="28,*,28,28,28,28,36"
                                                          ColumnSpacing="2"
                                                          Padding="6,5"
                                                          BackgroundColor="{StaticResource SurfaceMuted}">
                                                        <Label Text="{Binding Rank}" FontSize="12" FontAttributes="Bold"
                                                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                                                               TextColor="{StaticResource Secondary}" />
                                                        <Label Grid.Column="1" Text="{Binding TeamName}" FontSize="13" FontAttributes="Bold"
                                                               LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                        <Label Grid.Column="2" Text="{Binding Played}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                                        <Label Grid.Column="3" Text="{Binding Won}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                                        <Label Grid.Column="4" Text="{Binding Lost}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                                        <Label Grid.Column="5" Text="{Binding Tied}" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
                                                        <Label Grid.Column="6" Text="{Binding Points}" FontSize="12" FontAttributes="Bold"
                                                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                                                               TextColor="{StaticResource Primary}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Fixtures" Style="{StaticResource SectionLabel}" />
                        <Label Text="Tap Result to mark the winner. Knockouts cannot be tied."
                               Style="{StaticResource MutedLabel}"
                               FontSize="11"
                               Margin="0,-6,0,0" />
                        <Label Text="No fixtures yet."
                               IsVisible="{Binding ShowNoMatches}"
                               Style="{StaticResource MutedLabel}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MatchGroups}"
                                             IsVisible="{Binding HasMatches}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SchedulerMatchGroup">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               Margin="2,2,0,0"
                                               TextColor="{StaticResource Primary}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Matches}" Spacing="4">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="svc:SchedulerMatchView">
                                                    <Border Stroke="{StaticResource Gray200}"
                                                            StrokeThickness="1"
                                                            BackgroundColor="{StaticResource CardBackground}"
                                                            StrokeShape="RoundRectangle 10"
                                                            Padding="10,8">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                                <Label Text="{Binding Label}"
                                                                       FontSize="11"
                                                                       Style="{StaticResource MutedLabel}" />
                                                                <Label Text="{Binding VsLine}"
                                                                       FontAttributes="Bold"
                                                                       FontSize="14"
                                                                       LineBreakMode="TailTruncation"
                                                                       TextColor="{StaticResource Primary}" />
                                                                <Label Text="{Binding ResultText}"
                                                                       IsVisible="{Binding HasResult}"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{StaticResource Success}" />
                                                            </VerticalStackLayout>
                                                            <Button Grid.Column="1"
                                                                    Text="{Binding ActionLabel}"
                                                                    FontSize="12"
                                                                    FontAttributes="Bold"
                                                                    Padding="12,0"
                                                                    HeightRequest="32"
                                                                    MinimumHeightRequest="32"
                                                                    MinimumWidthRequest="72"
                                                                    CornerRadius="8"
                                                                    VerticalOptions="Center"
                                                                    IsVisible="{Binding BothTeamsKnown}"
                                                                    Clicked="OnResultClicked"
                                                                    CommandParameter="{Binding .}">
                                                                <Button.Triggers>
                                                                    <DataTrigger TargetType="Button" Binding="{Binding HasResult}" Value="True">
                                                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMuted}" />
                                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger TargetType="Button" Binding="{Binding HasResult}" Value="False">
                                                                        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                                    </DataTrigger>
                                                                </Button.Triggers>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid IsVisible="{Binding ShowTieBreakModal}" BackgroundColor="#990D1B2A">
            <Border Style="{StaticResource CardBorder}"
                    Padding="16"
                    Margin="18"
                    VerticalOptions="Center"
                    MaximumWidthRequest="480">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tied on points"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding TieBreakMessage}" FontSize="13" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TieBreakCountLine}" FontSize="13" FontAttributes="Bold" />
                    <ScrollView MaximumHeightRequest="320">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TieBreakPicks}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SchedulerTieBreakPick">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{StaticResource SurfaceMuted}"
                                            Padding="10,8"
                                            StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                <Label Text="{Binding Meta}" FontSize="12" Style="{StaticResource MutedLabel}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Button Text="Confirm knockout teams"
                            Style="{StaticResource GoldButton}"
                            HeightRequest="44"
                            IsEnabled="{Binding CanConfirmTieBreak}"
                            Command="{Binding ConfirmTieBreakCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
