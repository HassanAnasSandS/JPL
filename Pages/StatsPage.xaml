<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:pages="clr-namespace:JPL.Pages"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.StatsPage"
             x:Name="ThisPage"
             x:DataType="vm:StatsViewModel"
             Title="Statistics"
             HideSoftInputOnTapped="True">

    <ContentPage.Resources>
        <Style x:Key="StatsChip" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinimumHeightRequest" Value="34" />
            <Setter Property="BackgroundColor" Value="#EEF1F5" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E8C84A" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#D4AF37" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                <Setter Property="Scale" Value="0.96" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="StatsSegment" TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#33D4AF37" />
                                <Setter Property="TextColor" Value="#D4AF37" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#D4AF37" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                <Setter Property="Scale" Value="0.96" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="StatsSortButton" TargetType="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>
        <Style x:Key="StatCell" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="StatsRowGrid" TargetType="Grid">
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <DataTemplate x:Key="MatchRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="52,44,44,44">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding Matches}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding Won}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding Loss}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding Tied}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TournamentRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="52,44,44,44">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding Tournaments}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding TournamentWon}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding TournamentLoss}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding TournamentTied}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SeriesRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="52,44,44,44">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding Series}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding SeriesWon}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding SeriesLoss}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding SeriesTied}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BattingRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="40,40,80,32,32,32,32,32,32,32,36,36,36,36,36,36,56,44,44">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding BallsFaced}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding Runs}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding HighestScoreText}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding Dots}" />
                <Label Grid.Column="4" Style="{StaticResource StatCell}" Text="{Binding Ones}" />
                <Label Grid.Column="5" Style="{StaticResource StatCell}" Text="{Binding Twos}" />
                <Label Grid.Column="6" Style="{StaticResource StatCell}" Text="{Binding Threes}" />
                <Label Grid.Column="7" Style="{StaticResource StatCell}" Text="{Binding Fours}" />
                <Label Grid.Column="8" Style="{StaticResource StatCell}" Text="{Binding Fives}" />
                <Label Grid.Column="9" Style="{StaticResource StatCell}" Text="{Binding Sixes}" />
                <Label Grid.Column="10" Style="{StaticResource StatCell}" Text="{Binding Dismissals}" />
                <Label Grid.Column="11" Style="{StaticResource StatCell}" Text="{Binding BowledOut}" />
                <Label Grid.Column="12" Style="{StaticResource StatCell}" Text="{Binding CaughtOut}" />
                <Label Grid.Column="13" Style="{StaticResource StatCell}" Text="{Binding LbwOut}" />
                <Label Grid.Column="14" Style="{StaticResource StatCell}" Text="{Binding RunOut}" />
                <Label Grid.Column="15" Style="{StaticResource StatCell}" Text="{Binding StumpedOut}" />
                <Label Grid.Column="16" Style="{StaticResource StatCell}" Text="{Binding HitWicketOut}" />
                <Label Grid.Column="17" Style="{StaticResource StatCell}" Text="{Binding BattingStrikeRateText}" />
                <Label Grid.Column="18" Style="{StaticResource StatCell}" Text="{Binding BattingAverageText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NetsBattingRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}"
                  WidthRequest="860"
                  ColumnDefinitions="40,40,80,32,32,32,32,32,32,32,36,36,36,36,36,36,56,48,72,72">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding BallsFaced}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding Runs}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding HighestScoreText}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding Dots}" />
                <Label Grid.Column="4" Style="{StaticResource StatCell}" Text="{Binding Ones}" />
                <Label Grid.Column="5" Style="{StaticResource StatCell}" Text="{Binding Twos}" />
                <Label Grid.Column="6" Style="{StaticResource StatCell}" Text="{Binding Threes}" />
                <Label Grid.Column="7" Style="{StaticResource StatCell}" Text="{Binding Fours}" />
                <Label Grid.Column="8" Style="{StaticResource StatCell}" Text="{Binding Fives}" />
                <Label Grid.Column="9" Style="{StaticResource StatCell}" Text="{Binding Sixes}" />
                <Label Grid.Column="10" Style="{StaticResource StatCell}" Text="{Binding Dismissals}" />
                <Label Grid.Column="11" Style="{StaticResource StatCell}" Text="{Binding BowledOut}" />
                <Label Grid.Column="12" Style="{StaticResource StatCell}" Text="{Binding CaughtOut}" />
                <Label Grid.Column="13" Style="{StaticResource StatCell}" Text="{Binding LbwOut}" />
                <Label Grid.Column="14" Style="{StaticResource StatCell}" Text="{Binding RunOut}" />
                <Label Grid.Column="15" Style="{StaticResource StatCell}" Text="{Binding StumpedOut}" />
                <Label Grid.Column="16" Style="{StaticResource StatCell}" Text="{Binding HitWicketOut}" />
                <Label Grid.Column="17" Style="{StaticResource StatCell}" Text="{Binding BattingStrikeRateText}" />
                <Label Grid.Column="18" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding AvgPerSessionText}" />
                <Label Grid.Column="19" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding AvgPerOutText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BowlingRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="40,40,36,48,40,32,36,36,32,32,32,32,32,32,56,32,44,44">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding OversBowledBalls}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding RunsConceded}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding Wickets}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding BestBowlingText}" />
                <Label Grid.Column="4" Style="{StaticResource StatCell}" Text="{Binding HatTricks}" />
                <Label Grid.Column="5" Style="{StaticResource StatCell}" Text="{Binding DotBallsBowled}" />
                <Label Grid.Column="6" Style="{StaticResource StatCell}" Text="{Binding WidesBowled}" />
                <Label Grid.Column="7" Style="{StaticResource StatCell}" Text="{Binding NoBallsBowled}" />
                <Label Grid.Column="8" Style="{StaticResource StatCell}" Text="{Binding ByesConceded}" />
                <Label Grid.Column="9" Style="{StaticResource StatCell}" Text="{Binding LegByesConceded}" />
                <Label Grid.Column="10" Style="{StaticResource StatCell}" Text="{Binding BowledWkts}" />
                <Label Grid.Column="11" Style="{StaticResource StatCell}" Text="{Binding CaughtWkts}" />
                <Label Grid.Column="12" Style="{StaticResource StatCell}" Text="{Binding LbwWkts}" />
                <Label Grid.Column="13" Style="{StaticResource StatCell}" Text="{Binding StumpedWkts}" />
                <Label Grid.Column="14" Style="{StaticResource StatCell}" Text="{Binding HitWicketWkts}" />
                <Label Grid.Column="15" Style="{StaticResource StatCell}" Text="{Binding RunOutWkts}" />
                <Label Grid.Column="16" Style="{StaticResource StatCell}" Text="{Binding BowlingStrikeRateText}" />
                <Label Grid.Column="17" Style="{StaticResource StatCell}" Text="{Binding BowlingEconomyText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FieldingRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="64,72,72">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding Catches}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding RunOutsEffected}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding Stumpings}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CaptaincyRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="44,44,44,44,52,44,44,44,52,44,44,44">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding CaptainMatches}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding CaptainWon}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding CaptainLoss}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding CaptainTied}" />
                <Label Grid.Column="4" Style="{StaticResource StatCell}" Text="{Binding CaptainTournaments}" />
                <Label Grid.Column="5" Style="{StaticResource StatCell}" Text="{Binding CaptainTournamentWon}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="6" Style="{StaticResource StatCell}" Text="{Binding CaptainTournamentLoss}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="7" Style="{StaticResource StatCell}" Text="{Binding CaptainTournamentTied}" />
                <Label Grid.Column="8" Style="{StaticResource StatCell}" Text="{Binding CaptainSeries}" />
                <Label Grid.Column="9" Style="{StaticResource StatCell}" Text="{Binding CaptainSeriesWon}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="10" Style="{StaticResource StatCell}" Text="{Binding CaptainSeriesLoss}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="11" Style="{StaticResource StatCell}" Text="{Binding CaptainSeriesTied}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AttendanceRowTemplate" x:DataType="svc:PlayerCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="56,64,64,56">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Style="{StaticResource StatCell}" Text="{Binding AttendanceTotal}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding AttendancePresent}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding AttendanceAbsent}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding AttendancePctText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TeamRowTemplate" x:DataType="svc:TeamCareerSummary">
            <Grid Style="{StaticResource StatsRowGrid}" ColumnDefinitions="44,44,44,44,44,52,56,48,48,52,48,52,48,48,48">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsAltRow}" Value="True">
                        <Setter Property="BackgroundColor" Value="#F0F3F7" />
                    </DataTrigger>
                </Grid.Triggers>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding BindingContext.OpenTeamCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                        CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <Label Style="{StaticResource StatCell}" Text="{Binding Played}" />
                <Label Grid.Column="1" Style="{StaticResource StatCell}" Text="{Binding Won}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding Lost}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="3" Style="{StaticResource StatCell}" Text="{Binding Tied}" />
                <Label Grid.Column="4" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding Points}" />
                <Label Grid.Column="5" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding WinPctText}" />
                <Label Grid.Column="6" Style="{StaticResource StatCell}" FontAttributes="Bold" Text="{Binding NrrText}" />
                <Label Grid.Column="7" Style="{StaticResource StatCell}" Text="{Binding RunsFor}" />
                <Label Grid.Column="8" Style="{StaticResource StatCell}" Text="{Binding RunsAgainst}" />
                <Label Grid.Column="9" Style="{StaticResource StatCell}" Text="{Binding Tournaments}" />
                <Label Grid.Column="10" Style="{StaticResource StatCell}" Text="{Binding TournamentWon}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="11" Style="{StaticResource StatCell}" Text="{Binding Series}" />
                <Label Grid.Column="12" Style="{StaticResource StatCell}" Text="{Binding SeriesWon}" TextColor="{StaticResource Success}" />
                <Label Grid.Column="13" Style="{StaticResource StatCell}" Text="{Binding SeriesLoss}" TextColor="{StaticResource Danger}" />
                <Label Grid.Column="14" Style="{StaticResource StatCell}" Text="{Binding SeriesTied}" />
            </Grid>
        </DataTemplate>
        <pages:StatsTabTemplateSelector x:Key="StatsRowSelector"
                                        Match="{StaticResource MatchRowTemplate}"
                                        Tournament="{StaticResource TournamentRowTemplate}"
                                        Series="{StaticResource SeriesRowTemplate}"
                                        Batting="{StaticResource BattingRowTemplate}"
                                        NetsBatting="{StaticResource NetsBattingRowTemplate}"
                                        Bowling="{StaticResource BowlingRowTemplate}"
                                        Fielding="{StaticResource FieldingRowTemplate}"
                                        Captaincy="{StaticResource CaptaincyRowTemplate}"
                                        Attendance="{StaticResource AttendanceRowTemplate}" />
    </ContentPage.Resources>

    <Grid Padding="10" RowDefinitions="*,Auto" VerticalOptions="Fill"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <Grid IsVisible="{Binding ShowTable}"
              RowDefinitions="Auto,Auto,Auto,Auto,*"
              RowSpacing="10"
              VerticalOptions="Fill">

            <Border StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="4"
                    StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <ctrl:TabChipButton Text="Matches"
                            Style="{StaticResource StatsSegment}"
                            Command="{Binding SelectSourceCommand}"
                            CommandParameter="matches">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsMatchesSource}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Grid.Column="1"
                            Text="Nets"
                            Style="{StaticResource StatsSegment}"
                            Command="{Binding SelectSourceCommand}"
                            CommandParameter="nets">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsNetsSource}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                </Grid>
            </Border>

            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6">
                    <ctrl:TabChipButton Text="Match"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="match"
                            IsVisible="{Binding ShowMatchCategories}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsMatchStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Tournament"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="tournament"
                            IsVisible="{Binding ShowMatchCategories}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsTournamentStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Series"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="series"
                            IsVisible="{Binding ShowMatchCategories}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSeriesStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Batting"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="batting">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBattingStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Bowling"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="bowling">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBowlingStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Fielding"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="fielding">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFieldingStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Captaincy"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="captaincy"
                            IsVisible="{Binding ShowMatchCategories}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsCaptaincyStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Attendance"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="attendance"
                            IsVisible="{Binding ShowMatchCategories}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsAttendanceStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                    <ctrl:TabChipButton Text="Teams"
                            Style="{StaticResource StatsChip}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="teams"
                            IsVisible="{Binding ShowMatchCategories}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsTeamStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </ctrl:TabChipButton>
                </HorizontalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <SearchBar Placeholder="{Binding SearchPlaceholder}"
                               Text="{Binding PlayerNameFilter}"
                               CancelButtonColor="{StaticResource Primary}" />
                    <Button Grid.Column="1"
                            Text="{Binding FiltersToggleText}"
                            Command="{Binding ToggleFiltersCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="12,8"
                            FontSize="12"
                            VerticalOptions="Center">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasActiveFilters}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2"
                            Text="Clear"
                            Style="{StaticResource GhostButton}"
                            Padding="12,8"
                            FontSize="12"
                            VerticalOptions="Center"
                            IsVisible="{Binding HasActiveFilters}"
                            Command="{Binding ClearFiltersCommand}" />
                </Grid>
                <Border Style="{StaticResource CardBorder}"
                        Padding="12"
                        IsVisible="{Binding ShowFilters}">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout IsVisible="{Binding ShowMatchCategories}">
                            <ctrl:FormatMultiSelectView BindingContext="{Binding FormatFilter}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowMatchCategories}">
                            <Label Text="Venue"
                                   VerticalOptions="Center"
                                   FontSize="12"
