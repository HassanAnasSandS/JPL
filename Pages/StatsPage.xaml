    <ContentPage.Resources>
        <Style x:Key="StatsChip" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinimumHeightRequest" Value="34" />
            <Setter Property="BackgroundColor" Value="#EEF1F5" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E8C84A" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#D4AF37" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                <Setter Property="Scale" Value="0.96" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="StatsSegment" TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
