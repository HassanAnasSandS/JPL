                            </Border>
                            <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Absent" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding SelectedCareer.AttendanceAbsent}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Att %" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding SelectedCareer.AttendancePctText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="Payment" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Total" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding SelectedCareer.PaymentTotalText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Paid" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding SelectedCareer.PaymentPaidText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Success}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Remain" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding SelectedCareer.PaymentRemainingText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Danger}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Paid %" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding SelectedCareer.PaymentPaidPctText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Head to head -->
                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ConfrontationSectionTitle}" Style="{StaticResource SectionLabel}" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Batting vs bowling"
                                        Style="{StaticResource StatsChip}"
                                        Command="{Binding ShowBattingCommand}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsBattingTab}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Bowling vs batting"
                                        Style="{StaticResource StatsChip}"
                                        Command="{Binding ShowBowlingCommand}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsBowlingTab}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Fielding"
                                        Style="{StaticResource StatsChip}"
                                        Command="{Binding ShowFieldingVsCommand}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsFieldingTab}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Captain vs captain"
                                        Style="{StaticResource StatsChip}"
                                        Command="{Binding ShowCaptainVsCommand}"
                                        IsVisible="{Binding ShowMatchCategories}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCaptainTab}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <Label Text="{Binding ConfrontationHeader}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Confrontations}"
                                             Spacing="10"
                                             IsVisible="{Binding ShowConfrontationsList}">
                            <BindableLayout.EmptyView>
                                <Label Text="No head-to-head yet"
                                       Style="{StaticResource MutedLabel}"
                                       Margin="4" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:ConfrontationStat">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{StaticResource SurfaceMuted}"
                                            Padding="12"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding BatterName}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="VS"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Secondary}"
                                                       VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center" />
                                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding BowlerName}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                                <VerticalStackLayout>
                                                    <Label Text="Balls" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Balls}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="Runs" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Runs}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2">
                                                    <Label Text="Dismissals" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Outs}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="3">
                                                    <Label Text="Strike rate" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding StrikeRate}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Label FontSize="11" Style="{StaticResource MutedLabel}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="0:" />
                                                        <Span Text="{Binding Dots}" />
                                                        <Span Text="  1:" />
                                                        <Span Text="{Binding Ones}" />
                                                        <Span Text="  2:" />
                                                        <Span Text="{Binding Twos}" />
                                                        <Span Text="  4:" />
                                                        <Span Text="{Binding Fours}" />
                                                        <Span Text="  6:" />
                                                        <Span Text="{Binding Sixes}" />
                                                        <Span Text="  ·  Avg " />
                                                        <Span Text="{Binding AverageText}" />
                                                        <Span Text="  ·  Econ " />
                                                        <Span Text="{Binding BowlingEconomy}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11"
                                                   Style="{StaticResource MutedLabel}"
                                                   IsVisible="{Binding HasWicketTypes}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Wickets — Bowled " />
                                                        <Span Text="{Binding Bowled}" FontAttributes="Bold" />
                                                        <Span Text="  ·  Caught " />
                                                        <Span Text="{Binding Caught}" FontAttributes="Bold" />
                                                        <Span Text="  ·  LBW " />
                                                        <Span Text="{Binding Lbw}" FontAttributes="Bold" />
                                                        <Span Text="  ·  Run out " />
                                                        <Span Text="{Binding RunOut}" FontAttributes="Bold" />
                                                        <Span Text="  ·  Stumped " />
                                                        <Span Text="{Binding Stumped}" FontAttributes="Bold" />
                                                        <Span Text="  ·  Hit wicket " />
                                                        <Span Text="{Binding HitWicket}" FontAttributes="Bold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FieldingVs}"
                                             Spacing="10"
                                             IsVisible="{Binding IsFieldingTab}">
                            <BindableLayout.EmptyView>
                                <Label Text="No fielding head-to-head yet"
                                       Style="{StaticResource MutedLabel}"
                                       Margin="4" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:FieldingVsStat">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{StaticResource SurfaceMuted}"
                                            Padding="12"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding FielderName}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="VS"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Secondary}"
                                                       VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center" />
                                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding BatterName}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                                                <VerticalStackLayout>
                                                    <Label Text="Ct" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Catches}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="RO" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding RunOuts}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2">
                                                    <Label Text="St" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Stumpings}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="3">
                                                    <Label Text="Drop" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding DroppedCatches}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Danger}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="4">
                                                    <Label Text="Total" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Total}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primary}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CaptainVs}"
                                             Spacing="10"
                                             IsVisible="{Binding IsCaptainTab}">
                            <BindableLayout.EmptyView>
                                <Label Text="No captain vs captain matches yet"
                                       Style="{StaticResource MutedLabel}"
                                       Margin="4" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:CaptainVsStat">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{StaticResource SurfaceMuted}"
                                            Padding="12"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding CaptainName}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="VS"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Secondary}"
                                                       VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center" />
                                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding OpponentCaptainName}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                                                <VerticalStackLayout>
                                                    <Label Text="Pld" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Played}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="Won" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Won}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Success}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2">
                                                    <Label Text="Lost" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Lost}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Danger}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="3">
                                                    <Label Text="Tied" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Tied}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="4">
                                                    <Label Text="Win%" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding WinPctText}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primary}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                                <VerticalStackLayout>
                                                    <Label Text="Pts" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Points}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primary}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="NRR" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding NrrText}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primary}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2">
                                                    <Label Text="RF" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding RunsFor}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="3">
                                                    <Label Text="RA" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding RunsAgainst}" FontAttributes="Bold" FontSize="14" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <VerticalStackLayout IsVisible="{Binding HasSeries}" Spacing="4">
                                                <Label FontSize="12" TextColor="{StaticResource TextSecondary}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Series " />
                                                            <Span Text="{Binding Series}" />
                                                            <Span Text="  ·  " />
                                                            <Span Text="{Binding SeriesRecordText}" />
                                                            <Span Text=" (W–L–T)" />
                                                            <Span Text="  ·  Win% " />
                                                            <Span Text="{Binding SeriesWinPctText}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowTeamDetail}">
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Squad" Style="{StaticResource SectionLabel}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TeamSquad}" Spacing="6">
                                <BindableLayout.EmptyView>
                                    <Label Text="No squad players listed"
                                           Style="{StaticResource MutedLabel}"
                                           Margin="4" />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="svc:TeamSquadPlayerRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="2,2">
                                            <Label Text="{Binding PlayerName}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Primary}"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                                    Padding="8,3"
                                                    StrokeShape="RoundRectangle 8"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding RoleText}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Match record" Style="{StaticResource SectionLabel}" />
                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                                <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="Played" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.Played}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="Won" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.Won}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Success}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="Lost" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.Lost}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Danger}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="Tied" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.Tied}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="4" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="Win %" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.WinPctText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Label Text="Points" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="Pts" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.Points}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="NRR" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.NrrText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="RF" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.RunsFor}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="RA" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding SelectedTeam.RunsAgainst}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="1 vs 1" Style="{StaticResource SectionLabel}" />
                            <Label Text="Record against every team this side has faced."
                                   Style="{StaticResource MutedLabel}"
                                   FontSize="12" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TeamVs}" Spacing="10">
                                <BindableLayout.EmptyView>
                                    <Label Text="No 1 vs 1 matches yet"
                                           Style="{StaticResource MutedLabel}"
                                           Margin="4" />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="svc:TeamVsStat">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{StaticResource SurfaceMuted}"
                                                Padding="12"
                                                StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label Text="{Binding TeamName}"
                                                               FontAttributes="Bold"
                                                               FontSize="14"
                                                               TextColor="{StaticResource Primary}"
                                                               HorizontalTextAlignment="Center"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1"
                                                           Text="VS"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Secondary}"
                                                           VerticalOptions="Center"
                                                           HorizontalTextAlignment="Center" />
                                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label Text="{Binding OpponentTeamName}"
                                                               FontAttributes="Bold"
                                                               FontSize="14"
                                                               TextColor="{StaticResource Primary}"
                                                               HorizontalTextAlignment="Center"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Label FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Record " />
                                                            <Span Text="{Binding RecordText}" />
                                                            <Span Text="  ·  Win% " />
                                                            <Span Text="{Binding WinPctText}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                                    <VerticalStackLayout>
                                                        <Label Text="Pld" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                        <Label Text="{Binding Played}" FontAttributes="Bold" FontSize="14" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Text="Won" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                        <Label Text="{Binding Won}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Success}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2">
                                                        <Label Text="Lost" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                        <Label Text="{Binding Lost}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Danger}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="3">
                                                        <Label Text="Tied" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                        <Label Text="{Binding Tied}" FontAttributes="Bold" FontSize="14" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                    <VerticalStackLayout>
                                                        <Label Text="Runs for" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                        <Label Text="{Binding RunsFor}" FontAttributes="Bold" FontSize="14" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Text="Runs against" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                        <Label Text="{Binding RunsAgainst}" FontAttributes="Bold" FontSize="14" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2">
                                                        <Label Text="NRR" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                        <Label Text="{Binding NrrText}" FontAttributes="Bold" FontSize="14" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Label IsVisible="{Binding HasSeries}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextSecondary}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Series " />
                                                            <Span Text="{Binding Series}" />
                                                            <Span Text="  ·  " />
                                                            <Span Text="{Binding SeriesRecordText}" />
                                                            <Span Text=" (W–L–T)" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="#B00020" />

        <!-- Compact overlay so the table stays readable while sorting/loading -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding ShowLoading}"
              ZIndex="10"
              BackgroundColor="#220D1B2A">
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                    Padding="22,18"
                    StrokeShape="RoundRectangle 16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding ShowLoading}"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="36"
                                       WidthRequest="36"
                                       HorizontalOptions="Center" />
                    <Label Text="{Binding LoadingMessage}"
                           TextColor="{StaticResource Primary}"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
