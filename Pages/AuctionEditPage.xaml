<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             x:Class="JPL.Pages.AuctionEditPage"
             x:Name="ThisPage"
             x:DataType="vm:AuctionEditViewModel"
             Title="{Binding PageTitle}"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="*,Auto" Padding="12">
        <ScrollView>
            <VerticalStackLayout Spacing="12" Padding="0,0,0,12">

                <!-- ===== VIEW MODE ===== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsViewMode}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding AuctionDate, StringFormat='{0:dd MMM yyyy}'}"
                                   Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding ViewSummaryText}"
                                   FontSize="12"
                                   TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Padding="14,10"
                                VerticalOptions="Start"
                                Style="{StaticResource GoldButton}"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding CanRefresh}" />
                    </Grid>

                    <!-- Captains + wallets -->
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Captains &amp; wallets" Style="{StaticResource SectionLabel}" Margin="0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedCaptains}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuctionCaptainEditor">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                                Padding="12"
                                                StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding PlayerName}"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       TextColor="{StaticResource Primary}" />
                                                <Label Text="{Binding WalletSummary}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Secondary}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="No captains yet."
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding HasNoSelectedCaptains}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Sold — grouped by captain -->
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sold players" Style="{StaticResource SectionLabel}" Margin="0" />
                                <Label Grid.Column="1"
                                       Text="{Binding TotalSoldAmount, StringFormat='{0:N0}'}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Secondary}" />
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SoldByCaptain}"
                                                 Spacing="14"
                                                 IsVisible="{Binding HasSoldLots}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuctionCaptainPurchaseGroup">
                                        <VerticalStackLayout Spacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding CaptainName}"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource Primary}" />
                                                <Label Text="{Binding HeaderLine}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Secondary}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}" Spacing="8">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AuctionLotEditor">
                                                        <Border StrokeThickness="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                                                Padding="12"
                                                                StrokeShape="RoundRectangle 12">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <VerticalStackLayout Spacing="2">
                                                                    <Label Text="{Binding PlayerName}"
                                                                           FontAttributes="Bold"
                                                                           FontSize="15"
                                                                           TextColor="{StaticResource Primary}" />
                                                                    <Label Text="{Binding BasePriceLine}"
                                                                           FontSize="12"
                                                                           Style="{StaticResource MutedLabel}" />
                                                                </VerticalStackLayout>
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding SoldPriceLine}"
                                                                       FontSize="14"
                                                                       FontAttributes="Bold"
                                                                       VerticalOptions="Center"
                                                                       TextColor="{StaticResource Secondary}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="No sold players yet."
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding HasNoSoldLots}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Unsold -->
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Unsold players" Style="{StaticResource SectionLabel}" Margin="0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding UnsoldLots}"
                                                 Spacing="8"
                                                 IsVisible="{Binding HasUnsoldLots}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuctionLotEditor">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                                Padding="12"
                                                StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding PlayerName}"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource Primary}" />
                                                <Label Text="{Binding BasePriceLine}"
                                                       FontSize="12"
                                                       Style="{StaticResource MutedLabel}" />
                                                <Label Text="Unsold"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Danger}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="No unsold players."
                                   Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding HasNoUnsoldLots}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ===== EDIT MODE ===== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding CanEdit}">
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Auction details" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Entry Placeholder="Auction name *"
                                   Text="{Binding Title}"
                                   MaxLength="160" />
                            <DatePicker Date="{Binding AuctionDate}" />
                            <Label Text="Need at least 2 captains and 1 player to save (live watch)."
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Captains (buyers) *" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Label Text="Select minimum 2 captains, then set each wallet."
                                   Style="{StaticResource MutedLabel}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CaptainCandidates}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SelectablePlayer">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding FullName}"
                                                   VerticalOptions="Center"
                                                   FontSize="14"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                            <Button Grid.Column="1"
                                                    Padding="12,6"
                                                    FontSize="12"
                                                    MinimumWidthRequest="76"
                                                    Clicked="OnToggleCaptainClicked"
                                                    CommandParameter="{Binding .}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Text" Value="Added" />
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="Text" Value="Add" />
                                                        <Setter Property="BackgroundColor" Value="#E8EEF5" />
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding HasSelectedCaptains}" Spacing="8" Margin="0,6,0,0">
                                <Label Text="CAPTAIN WALLETS"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Secondary}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedCaptains}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AuctionCaptainEditor">
                                            <Border StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                                    Padding="12"
                                                    StrokeShape="RoundRectangle 12">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding PlayerName}"
                                                           FontAttributes="Bold"
                                                           FontSize="15"
                                                           TextColor="{StaticResource Primary}" />
                                                    <Label Text="Wallet amount"
                                                           FontSize="11"
                                                           Style="{StaticResource MutedLabel}" />
                                                    <Entry Keyboard="Numeric"
                                                           Text="{Binding WalletAmount}"
                                                           Placeholder="e.g. 50000" />
                                                    <Label Text="{Binding BudgetLine}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}" />
                                                    <Label Text="Over budget — reduce purchases or raise wallet"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Danger}"
                                                           IsVisible="{Binding IsOverBudget}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Auction players *" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Label Text="Select at least 1 player."
                                   Style="{StaticResource MutedLabel}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlayerCandidates}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SelectablePlayer">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding FullName}"
                                                   VerticalOptions="Center"
                                                   FontSize="14"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                            <Button Grid.Column="1"
                                                    Padding="12,6"
                                                    FontSize="12"
                                                    MinimumWidthRequest="76"
                                                    Clicked="OnTogglePlayerClicked"
                                                    CommandParameter="{Binding .}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Text" Value="Added" />
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="Text" Value="Add" />
                                                        <Setter Property="BackgroundColor" Value="#E8EEF5" />
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14" IsVisible="{Binding HasLots}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Prices &amp; sales" Style="{StaticResource SectionLabel}" Margin="0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lots}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuctionLotEditor">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                                Padding="12"
                                                StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="8">
                                                <Label Text="{Binding PlayerName}"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource Primary}" />
                                                <Label Text="Base price" FontSize="11" Style="{StaticResource MutedLabel}" />
                                                <Entry Keyboard="Numeric" Text="{Binding BasePrice}" />
                                                <HorizontalStackLayout Spacing="10">
                                                    <CheckBox IsChecked="{Binding IsSold}" Color="{StaticResource Primary}" />
                                                    <Label Text="Sold" VerticalOptions="Center" FontSize="14" />
                                                </HorizontalStackLayout>
                                                <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowSoldFields}">
                                                    <Label Text="Sold price" FontSize="11" Style="{StaticResource MutedLabel}" />
                                                    <Entry Keyboard="Numeric" Text="{Binding SoldPrice}" />
                                                    <Label Text="Sold to captain" FontSize="11" Style="{StaticResource MutedLabel}" />
                                                    <Picker Title="Select captain"
                                                            ItemsSource="{Binding CaptainChoices}"
                                                            ItemDisplayBinding="{Binding PickerLabel}"
                                                            SelectedItem="{Binding SoldToCaptain}" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Danger}"
                       FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Text="Save auction"
                Style="{StaticResource GoldButton}"
                Margin="0,8,0,0"
                IsVisible="{Binding CanEdit}"
                Command="{Binding SaveCommand}" />
    </Grid>
</ContentPage>
