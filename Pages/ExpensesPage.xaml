<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.ExpensesPage"
             x:Name="ThisPage"
             x:DataType="vm:ExpensesViewModel"
             Title="Expenses" HideSoftInputOnTapped="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                <Label Text="Expenses" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Add" Style="{StaticResource GoldButton}" Padding="16,10" IsVisible="{Binding CanWrite}" Command="{Binding AddCommand}" />
        </Grid>
        <ctrl:FilterDrawer Grid.Row="1" HasActiveFilters="{Binding HasFilter}" ClearCommand="{Binding ClearFilterCommand}">
            <SearchBar Placeholder="Filter expense or purchaser" Text="{Binding NameFilter}" CancelButtonColor="{StaticResource Primary}" />
        </ctrl:FilterDrawer>
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}" RemainingItemsThreshold="3" RemainingItemsThresholdReached="OnLoadMore">
                <CollectionView.EmptyView><Label Text="No expenses recorded yet" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" Margin="18" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExpenseRow">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding PurchasedByLine}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="1">
                                        <Label Text="{Binding AmountText}" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource Secondary}" HorizontalTextAlignment="End" />
                                        <Label Text="total" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                    <VerticalStackLayout Spacing="1"><Label Text="Paid" FontSize="10" TextColor="{StaticResource TextSecondary}" /><Label Text="{Binding ContributedText}" FontAttributes="Bold" TextColor="{StaticResource Success}" /></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1"><Label Text="Remaining" FontSize="10" TextColor="{StaticResource TextSecondary}" /><Label Text="{Binding OutstandingText}" FontAttributes="Bold" TextColor="{StaticResource Danger}" /></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="End"><Label Text="Date" FontSize="10" TextColor="{StaticResource TextSecondary}" /><Label Text="{Binding DateText}" /></VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding ContributorsLine}" FontSize="12" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding OwnerLine}" FontSize="11" TextColor="{StaticResource Primary}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="View" Padding="12,6" FontSize="12" BackgroundColor="#E8EEF5" TextColor="{StaticResource Primary}" Clicked="OnViewClicked" CommandParameter="{Binding .}" />
                                    <Button Text="Edit" Padding="12,6" FontSize="12" Style="{StaticResource GoldButton}" IsVisible="{Binding CanEdit}" Clicked="OnEditClicked" CommandParameter="{Binding .}" />
                                    <Button Text="Delete" Padding="12,6" FontSize="12" Style="{StaticResource DangerButton}" IsVisible="{Binding CanEdit}" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="3" Spacing="4">
            <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" Color="{StaticResource Secondary}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
