<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             x:Class="JPL.Pages.OwnerAvailabilityPage"
             x:Name="ThisPage"
             x:DataType="vm:OwnerAvailabilityViewModel"
             Title="Availability">
    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="14" RowSpacing="8">
                <Picker Title="Ground"
                        ItemsSource="{Binding GroundPicks}"
                        ItemDisplayBinding="{Binding Name, x:DataType=vm:GroundPick}"
                        SelectedItem="{Binding SelectedGround}"
                        IsVisible="{Binding HasGroundPicker}" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <Button Text="‹"
                            WidthRequest="48"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding PrevMonthCommand}" />
                    <Label Grid.Column="1"
                           Text="{Binding MonthTitle}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="›"
                            WidthRequest="48"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding NextMonthCommand}" />
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*,*" Padding="0,4,0,0">
                    <Label Text="Mon" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="1" Text="Tue" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="2" Text="Wed" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="3" Text="Thu" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="4" Text="Fri" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="5" Text="Sat" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="6" Text="Sun" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                </Grid>

                <CollectionView Grid.Row="3"
                                ItemsSource="{Binding CalendarDays}"
                                HeightRequest="276">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="7"
                                         HorizontalItemSpacing="3"
                                         VerticalItemSpacing="3" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarDayItem">
                            <Border BackgroundColor="{Binding Background}"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="0"
                                    HeightRequest="42">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectDayCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Label Text="{Binding DayNumber}"
                                           TextColor="{Binding TextColor}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <BoxView HeightRequest="6"
                                             WidthRequest="6"
                                             CornerRadius="3"
                                             Color="#C62828"
                                             HorizontalOptions="Center"
                                             VerticalOptions="End"
                                             Margin="0,0,0,4"
                                             IsVisible="{Binding HasBookings}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout Grid.Row="4" Spacing="6">
                    <HorizontalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="14" HeightRequest="14" CornerRadius="3" Color="#C62828" VerticalOptions="Center" />
                            <Label Text="Booked" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="14" HeightRequest="14" CornerRadius="3" Color="#D1FAE5" VerticalOptions="Center" />
                            <Label Text="Available" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <Label Text="{Binding SelectedDateLabel}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding DaySummary}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
                </VerticalStackLayout>

                <CollectionView Grid.Row="5" ItemsSource="{Binding Hours}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HourSlotItem">
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="8" HeightRequest="40" Margin="0,0,0,4">
                                <Label Text="{Binding TimeLabel}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding SlotColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenSlotCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding SlotTitle}"
                                           TextColor="{Binding SlotTextColor}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

        <Grid IsVisible="{Binding IsDetailOpen}">
            <BoxView Color="#990D1B2A">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseDetailCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Style="{StaticResource CardBorder}"
                    VerticalOptions="Center"
                    Margin="18"
                    Padding="16">
                <ScrollView MaximumHeightRequest="520">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Booking"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedHourBookings}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:GroundBookingDto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding GroundName}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Status}" TextColor="{StaticResource Secondary}" FontAttributes="Bold" />
                                    <Label Text="{Binding WhenLabel}" FontSize="13" />
                                    <Label Text="{Binding CustomerName}" FontSize="14" />
                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasCustomerWhatsApp}">
                                        <Image Source="whatsapp.svg"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               Aspect="AspectFit"
                                               VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.ChatCustomerCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                    CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <Label Text="{Binding CustomerPhoneDisplay}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#128C7E"
                                               TextDecorations="Underline"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.ChatCustomerCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding MoneyLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding ServicesLine}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Notes}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Close"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding CloseDetailCommand}" />
                </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
