<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:vm="clr-namespace:JPL.ViewModels"

             xmlns:domain="clr-namespace:JPL.Domain"

             x:Class="JPL.Pages.PlayersPage"
             x:Name="ThisPage"
             x:DataType="vm:PlayersViewModel"

             Title="Players"

             HideSoftInputOnTapped="True">



    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="14" RowSpacing="10">

        <Grid ColumnDefinitions="*,Auto">

            <Label Text="Squad"

                   FontSize="22"

                   FontAttributes="Bold"

                   VerticalOptions="Center"

                   TextColor="{StaticResource Primary}" />

            <Button Grid.Column="1"

                    Text="+ Add"

                    Style="{StaticResource GoldButton}"

                    Padding="16,10"

                    IsVisible="{Binding CanWrite}"

                    Clicked="OnAddClicked" />

        </Grid>



        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">

            <HorizontalStackLayout Spacing="8">

                <Button Text="{Binding AllFilterLabel}"

                        Command="{Binding SelectStatusCommand}"

                        CommandParameter="all"

                        Padding="14,8"

                        FontSize="13"

                        CornerRadius="18"

                        MinimumHeightRequest="40"

                        BackgroundColor="#E8EEF5"

                        TextColor="{StaticResource Primary}">

                    <Button.Triggers>

                        <DataTrigger TargetType="Button" Binding="{Binding IsAllFilter}" Value="True">

                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />

                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />

                        </DataTrigger>

                    </Button.Triggers>

                </Button>

                <Button Text="{Binding ActiveFilterLabel}"

                        Command="{Binding SelectStatusCommand}"

                        CommandParameter="active"

                        Padding="14,8"

                        FontSize="13"

                        CornerRadius="18"

                        MinimumHeightRequest="40"

                        BackgroundColor="#E8EEF5"

                        TextColor="{StaticResource Primary}">

                    <Button.Triggers>

                        <DataTrigger TargetType="Button" Binding="{Binding IsActiveFilter}" Value="True">

                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />

                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />

                        </DataTrigger>

                    </Button.Triggers>

                </Button>

                <Button Text="{Binding InactiveFilterLabel}"

                        Command="{Binding SelectStatusCommand}"

                        CommandParameter="deactive"

                        Padding="14,8"

                        FontSize="13"

                        CornerRadius="18"

                        MinimumHeightRequest="40"

                        BackgroundColor="#E8EEF5"

                        TextColor="{StaticResource Primary}">

                    <Button.Triggers>

                        <DataTrigger TargetType="Button" Binding="{Binding IsInactiveFilter}" Value="True">

                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />

                            <Setter Property="TextColor" Value="{StaticResource Secondary}" />

                        </DataTrigger>

                    </Button.Triggers>

                </Button>

            </HorizontalStackLayout>

        </ScrollView>



        <Border Grid.Row="2"

                Style="{StaticResource CardBorder}"

                Padding="12">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                <SearchBar Placeholder="Filter by name"

                           Text="{Binding NameFilter}"

                           CancelButtonColor="{StaticResource Primary}" />

                <Button Grid.Column="1"

                        Text="Clear"

                        Style="{StaticResource GhostButton}"

                        Padding="12,8"

                        IsVisible="{Binding HasActiveFilters}"

                        Command="{Binding ClearFiltersCommand}" />

            </Grid>

        </Border>



        <RefreshView Grid.Row="3"

                     VerticalOptions="Fill"

                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"

                     Command="{Binding LoadCommand}">

            <CollectionView ItemsSource="{Binding Items}"

                            SelectionMode="None"

                            VerticalOptions="Fill">

                <CollectionView.EmptyView>

                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">

                        <Label Text="No players found"

                               FontSize="16"

                               FontAttributes="Bold"

                               HorizontalOptions="Center"

                               TextColor="{StaticResource TextPrimary}" />

                        <Label Text="Try another filter, or add a player"

                               Style="{StaticResource MutedLabel}"

                               HorizontalOptions="Center"

                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="domain:Player">

                        <Border Style="{StaticResource CardBorder}">

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">

                                    <Label Text="{Binding FullName}"

                                           FontAttributes="Bold"

                                           FontSize="16"

                                           Style="{StaticResource BodyLabel}" />

                                    <Label Text="{Binding StatusText}"

                                           FontSize="12"

                                           FontAttributes="Bold"

                                           TextColor="{StaticResource Success}">

                                        <Label.Triggers>

                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">

                                                <Setter Property="TextColor" Value="{StaticResource Danger}" />

                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                </VerticalStackLayout>



                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                                      IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}">

                                    <Button Text="{Binding ToggleActiveLabel}"

                                            Style="{StaticResource GhostButton}"

                                            HorizontalOptions="Fill"

                                            Clicked="OnToggleActiveClicked"

                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="1"

                                            Text="Edit"

                                            Style="{StaticResource OutlineButton}"

                                            Padding="14,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            Clicked="OnEditClicked"

                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="2"

                                            Text="Del"

                                            Style="{StaticResource DangerButton}"

                                            Padding="12,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            Clicked="OnDeleteClicked"

                                            CommandParameter="{Binding .}" />

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>



        <Label Grid.Row="4"

               Text="{Binding ErrorMessage}"

               TextColor="{StaticResource Danger}"

               FontSize="12" />

    </Grid>

</ContentPage>


