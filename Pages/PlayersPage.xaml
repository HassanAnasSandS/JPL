<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:vm="clr-namespace:JPL.ViewModels"

             xmlns:domain="clr-namespace:JPL.Domain"

             xmlns:ctrl="clr-namespace:JPL.Controls"

             x:Class="JPL.Pages.PlayersPage"
             x:Name="ThisPage"
             x:DataType="vm:PlayersViewModel"

             Title="Players"

             HideSoftInputOnTapped="True">



    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14" RowSpacing="10">

        <Grid ColumnDefinitions="*,Auto">

            <Label Text="Squad"

                   FontSize="22"

                   FontAttributes="Bold"

                   VerticalOptions="Center"

                   TextColor="{StaticResource Primary}" />

            <HorizontalStackLayout Grid.Column="1" Spacing="8">

                    <Button Text="Public"

                        Style="{StaticResource OutlineButton}"

                        BackgroundColor="{StaticResource CardBackground}"

                        Padding="16,10"

                        Command="{Binding OpenPublicDirectoryCommand}" />

                    <Button Text="+ Add"

                    Style="{StaticResource GoldButton}"

                    Padding="16,10"

                    IsVisible="{Binding CanWrite}"

                    Clicked="OnAddClicked" />

            </HorizontalStackLayout>

        </Grid>



                <ctrl:FilterDrawer Grid.Row="1"
                           HasActiveFilters="{Binding HasActiveFilters}"
                           ClearCommand="{Binding ClearFiltersCommand}">
            <VerticalStackLayout Spacing="8">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{Binding AllFilterLabel}"
                                Command="{Binding SelectStatusCommand}"
                                CommandParameter="all"
                                Padding="14,8"
                                FontSize="13"
                                CornerRadius="18"
                                MinimumHeightRequest="40"
                                BackgroundColor="#E8EEF5"
                                TextColor="{StaticResource Primary}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsAllFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{Binding ActiveFilterLabel}"
                                Command="{Binding SelectStatusCommand}"
                                CommandParameter="active"
                                Padding="14,8"
                                FontSize="13"
                                CornerRadius="18"
                                MinimumHeightRequest="40"
                                BackgroundColor="#E8EEF5"
                                TextColor="{StaticResource Primary}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsActiveFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{Binding InactiveFilterLabel}"
                                Command="{Binding SelectStatusCommand}"
                                CommandParameter="deactive"
                                Padding="14,8"
                                FontSize="13"
                                CornerRadius="18"
                                MinimumHeightRequest="40"
                                BackgroundColor="#E8EEF5"
                                TextColor="{StaticResource Primary}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsInactiveFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </ScrollView>
                <SearchBar Placeholder="Filter by name"
                           Text="{Binding NameFilter}"
                           CancelButtonColor="{StaticResource Primary}" />
            </VerticalStackLayout>
        </ctrl:FilterDrawer>

<RefreshView Grid.Row="2"

                     VerticalOptions="Fill"

                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"

                     Command="{Binding LoadCommand}">

            <CollectionView ItemsSource="{Binding Items}"

                            SelectionMode="None"

                            VerticalOptions="Fill">

                <CollectionView.EmptyView>

                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">

                        <Label Text="No players found"

                               FontSize="16"

                               FontAttributes="Bold"

                               HorizontalOptions="Center"

                               TextColor="{StaticResource TextPrimary}" />

                        <Label Text="Try another filter, or add a player"

                               Style="{StaticResource MutedLabel}"

                               HorizontalOptions="Center"

                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="vm:PlayerRow">

                        <Border Style="{StaticResource CardBorder}">

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">

                                    <ctrl:RoundedPhotoView Photo="{Binding Photo}"

                                                           Initials="{Binding Initials}" />

                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">

                                    <Label Text="{Binding FullName}"

                                           FontAttributes="Bold"

                                           FontSize="16"

                                           Style="{StaticResource BodyLabel}" />

                                    <Label Text="{Binding StatusText}"

                                           FontSize="12"

                                           FontAttributes="Bold"

                                           TextColor="{Binding StatusColor}" />

                                        </VerticalStackLayout>

                                    </HorizontalStackLayout>

                                </Grid>



                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">

                                    <Button Text="{Binding ToggleActiveLabel}"

                                            Style="{StaticResource GhostButton}"

                                            HorizontalOptions="Fill"

                                            IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"

                                            Clicked="OnToggleActiveClicked"

                                            CommandParameter="{Binding Player}" />

                                    <Button Grid.Column="1"

                                            Text="View"

                                            Style="{StaticResource OutlineButton}"

                                            Padding="14,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            Clicked="OnViewClicked"

                                            CommandParameter="{Binding Player}" />

                                    <Button Grid.Column="2"

                                            Text="Edit"

                                            Style="{StaticResource OutlineButton}"

                                            Padding="14,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"

                                            Clicked="OnEditClicked"

                                            CommandParameter="{Binding Player}" />

                                    <Button Grid.Column="3"

                                            Text="Del"

                                            Style="{StaticResource DangerButton}"

                                            Padding="12,8"

                                            MinimumHeightRequest="40"

                                            FontSize="13"

                                            IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"

                                            Clicked="OnDeleteClicked"

                                            CommandParameter="{Binding Player}" />

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>



        <Label Grid.Row="3"

               Text="{Binding ErrorMessage}"

               TextColor="{StaticResource Danger}"

               FontSize="12" />

    </Grid>

</ContentPage>


