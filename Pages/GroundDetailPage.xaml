<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.GroundDetailPage"
             x:Name="ThisPage"
             x:DataType="vm:GroundDetailViewModel"
             Title="Ground"
             HideSoftInputOnTapped="True">
    <ContentPage.Resources>
        <Style x:Key="ViewerChromeButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="48" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="#990D1B2A" />
        </Style>
        <Style x:Key="ViewerZoomButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="52" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="WidthRequest" Value="52" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>
    </ContentPage.Resources>
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <ctrl:GroundImageSlider Images="{Binding Images}"
                                    Position="{Binding GalleryIndex}"
                                    OpenCommand="{Binding OpenViewerCommand}"
                                    IsVisible="{Binding HasImages}" />
            <Label Text="Videos" Style="{StaticResource SectionLabel}" IsVisible="{Binding HasVideos}" />
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding HasVideos}">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Videos}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="svc:GroundVideoDto">
                            <Border StrokeThickness="0"
                                    BackgroundColor="#152033"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="228"
                                    Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.OpenVideoCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="128,Auto">
                                    <Grid BackgroundColor="#0D1B2A">
                                        <Image Source="{Binding ThumbnailUrl}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding HasThumbnail}" />
                                        <BoxView Color="#66000000" />
                                        <Border StrokeThickness="0"
                                                BackgroundColor="#E6D4AF37"
                                                WidthRequest="52"
                                                HeightRequest="52"
                                                StrokeShape="RoundRectangle 26"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label Text="▶"
                                                   FontSize="22"
                                                   FontAttributes="Bold"
                                                   TextColor="#0D1B2A"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Margin="4,0,0,0" />
                                        </Border>
                                        <Label Text="{Binding Provider}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               BackgroundColor="#990D1B2A"
                                               Padding="8,3"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Start"
                                               Margin="8" />
                                    </Grid>
                                    <VerticalStackLayout Grid.Row="1" Padding="10,8" Spacing="2">
                                        <Label Text="{Binding DisplayTitle}"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Label Text="Tap to play"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <Label Text="{Binding Ground.Name}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Label Text="{Binding LocationLine}" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding RatingLine}" TextColor="{StaticResource Secondary}" FontAttributes="Bold" />
            <Label Text="{Binding RateLabel}" TextColor="{StaticResource Secondary}" FontAttributes="Bold" />
            <Label Text="Booking types" Style="{StaticResource SectionLabel}" IsVisible="{Binding HasOffers}" />
            <Label Text="{Binding RateWindowsLine}"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   IsVisible="{Binding HasOffers}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OfferedTypes}"
                                 Spacing="6"
                                 IsVisible="{Binding HasOffers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:GroundBookingOfferDto">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding BandsLine}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding PriceLabel}"
                                   TextColor="{StaticResource Secondary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="{Binding Ground.AddressLine}" />
            <Label Text="{Binding Ground.Description}" />
            <Label Text="Links" Style="{StaticResource SectionLabel}" IsVisible="{Binding HasLinks}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Links}"
                                 Spacing="6"
                                 IsVisible="{Binding HasLinks}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:GroundLinkDto">
                        <Button Text="{Binding DisplayTitle}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BindingContext.OpenLinkCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="{Binding AmenitiesLine}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding ServicesLine}" FontSize="13" TextColor="{StaticResource Secondary}" />
            <Label Text="{Binding ShopLine}" FontSize="13" TextColor="{StaticResource Secondary}" />
            <Button Text="Open in Google Maps" Style="{StaticResource GhostButton}" Command="{Binding OpenMapsCommand}" />
            <Button Text="Request booking"
                    Style="{StaticResource GoldButton}"
                    Command="{Binding BookCommand}"
                    IsVisible="{Binding CanRequestBooking}" />
            <HorizontalStackLayout Spacing="10"
                                   IsVisible="{Binding HasWhatsApp}">
                <ImageButton Source="whatsapp.svg"
                             WidthRequest="48"
                             HeightRequest="48"
                             Aspect="AspectFit"
                             BackgroundColor="Transparent"
                             Command="{Binding ContactCommand}"
                             SemanticProperties.Description="Chat with ground owner on WhatsApp" />
                <Label Text="Chat on WhatsApp"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="#25D366"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ContactCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
            <Label Text="Reviews and ratings" Style="{StaticResource SectionLabel}" />
            <Label Text="No reviews yet. Completed bookings can leave one review each."
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   IsVisible="{Binding ReviewsEmpty}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reviews}"
                                 Spacing="10"
                                 IsVisible="{Binding HasReviews}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:GroundReviewDto">
                        <Border Style="{StaticResource CardBorder}" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding ReviewerLine}" FontAttributes="Bold" />
                                    <Label Grid.Column="1"
                                           Text="{Binding StarsLabel}"
                                           TextColor="{StaticResource Secondary}" />
                                </Grid>
                                <Label Text="{Binding Comment}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       IsVisible="{Binding HasComment}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="More reviews"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding LoadMoreReviewsCommand}"
                    IsVisible="{Binding ReviewsHasMore}" />
            <ActivityIndicator IsRunning="{Binding ReviewsBusy}" IsVisible="{Binding ReviewsBusy}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>

    <Grid IsVisible="{Binding IsViewerOpen}"
          InputTransparent="False"
          ZIndex="40">
        <BoxView Color="#F2000000"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseViewerCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Grid Padding="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding GalleryCounter}"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Close"
                        BackgroundColor="#33FFFFFF"
                        TextColor="White"
                        FontSize="13"
                        Padding="14,8"
                        MinimumHeightRequest="40"
                        CornerRadius="12"
                        BorderWidth="0"
                        Command="{Binding CloseViewerCommand}" />
            </Grid>
            <Grid Grid.Row="1">
                <ctrl:ZoomableImageView x:Name="ViewerImage"
                                        Source="{Binding CurrentImageUrl}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
                <Button Text="‹"
                        Style="{StaticResource ViewerChromeButton}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Margin="4,0,0,0"
                        IsVisible="{Binding HasMultipleImages}"
                        Command="{Binding PreviousImageCommand}"
                        SemanticProperties.Description="Previous photo" />
                <Button Text="›"
                        Style="{StaticResource ViewerChromeButton}"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Margin="0,0,4,0"
                        IsVisible="{Binding HasMultipleImages}"
                        Command="{Binding NextImageCommand}"
                        SemanticProperties.Description="Next photo" />
            </Grid>
            <VerticalStackLayout Grid.Row="2" Spacing="8">
            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Center">
                <Button Text="−"
                        Style="{StaticResource ViewerZoomButton}"
                        Clicked="OnZoomOutClicked"
                        SemanticProperties.Description="Zoom out" />
                <Button Text="Reset"
                        FontSize="13"
                        Padding="16,8"
                        MinimumHeightRequest="52"
                        CornerRadius="26"
                        BorderWidth="0"
                        BackgroundColor="#33FFFFFF"
                        TextColor="White"
                        Clicked="OnZoomResetClicked"
                        SemanticProperties.Description="Reset zoom" />
                <Button Text="+"
                        Style="{StaticResource ViewerZoomButton}"
                        Clicked="OnZoomInClicked"
                        SemanticProperties.Description="Zoom in" />
            </HorizontalStackLayout>
            <Label Text="Pinch, mouse wheel, or + / − to zoom"
                   TextColor="#CCFFFFFF"
                   FontSize="12"
                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

    <Grid IsVisible="{Binding IsVideoPlayerOpen}"
          InputTransparent="False"
          ZIndex="45"
          BackgroundColor="#F2000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="12,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="{Binding PlayingVideoTitle}"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="16"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Button Grid.Column="1"
                    Text="Close"
                    BackgroundColor="#33FFFFFF"
                    TextColor="White"
                    FontSize="13"
                    Padding="14,8"
                    MinimumHeightRequest="40"
                    CornerRadius="12"
                    BorderWidth="0"
                    Command="{Binding CloseVideoCommand}" />
        </Grid>
        <Border Grid.Row="1"
                StrokeThickness="0"
                BackgroundColor="#000000"
                Margin="12,0"
                StrokeShape="RoundRectangle 16">
            <WebView Source="{Binding VideoPlayerSource}"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />
        </Border>
        <Label Grid.Row="2"
               Text="Plays in-app. The file stays on its site — we only store the link."
               TextColor="#CCFFFFFF"
               FontSize="12"
               Margin="16,10,16,16"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
    </Grid>
    </Grid>
</ContentPage>
