<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             x:Class="JPL.Pages.OwnerBookingsPage"
             x:Name="ThisPage"
             x:DataType="vm:OwnerBookingsViewModel"
             Title="Bookings">
    <Grid RowDefinitions="Auto,Auto,*" Padding="14" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Bookings" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Label Text="{Binding CountLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Book" Style="{StaticResource GoldButton}" Command="{Binding AddCommand}" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="4" IsVisible="{Binding HasGroundPicker}">
            <Label Text="Ground" Style="{StaticResource SectionLabel}" />
            <Picker Title="Select ground"
                    ItemsSource="{Binding GroundPicks}"
                    ItemDisplayBinding="{Binding Name, x:DataType=vm:GroundPick}"
                    SelectedItem="{Binding SelectedGround}" />
        </VerticalStackLayout>
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding ReloadCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            RemainingItemsThreshold="1"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            EmptyView="{Binding ErrorMessage}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:GroundBookingDto">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding GroundName}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding CustomerName}" FontSize="13" />
                                    <Label Text="{Binding WhenLabel}" FontSize="13" />
                                    <Label Text="{Binding Status}" TextColor="{StaticResource Secondary}" />
                                    <Label Text="{Binding MoneyLabel}" FontSize="12" />
                                    <Label Text="{Binding ServicesLine}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasServicesLine}" />
                                    <Label Text="{Binding ShopLine}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasShopLine}" />
                                    <Label Text="{Binding ReviewLine}"
                                           FontSize="12"
                                           TextColor="{StaticResource Secondary}"
                                           IsVisible="{Binding HasReview}" />
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="1"
                                             Source="whatsapp.svg"
                                             WidthRequest="44"
                                             HeightRequest="44"
                                             Aspect="AspectFit"
                                             BackgroundColor="Transparent"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding HasCustomerWhatsApp}"
                                             Command="{Binding BindingContext.ChatCustomerCommand, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                             CommandParameter="{Binding .}"
                                             SemanticProperties.Description="Chat with customer on WhatsApp" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
