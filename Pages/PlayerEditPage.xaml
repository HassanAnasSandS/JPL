<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             x:Class="JPL.Pages.PlayerEditPage"
             x:DataType="vm:PlayerEditViewModel"
             Title="{Binding Title}"
             HideSoftInputOnTapped="True">

    <ScrollView VerticalOptions="Fill"
                VerticalScrollBarVisibility="Default"
                HorizontalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="16" Spacing="14" VerticalOptions="Start">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Player name *" Style="{StaticResource SectionLabel}" />
                    <Entry Placeholder="Full name (required, unique)"
                           Text="{Binding FullName}"
                           FontSize="16"
                           MaxLength="120" />
                    <HorizontalStackLayout Spacing="10">
                        <Switch IsToggled="{Binding IsActive}" VerticalOptions="Center" />
                        <Label Text="Active (shown in team squad pickers)"
                               VerticalOptions="Center"
                               Style="{StaticResource BodyLabel}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Button Text="Save"
                    Style="{StaticResource GoldButton}"
                    Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Secondary}" />
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Danger}"
                   FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
