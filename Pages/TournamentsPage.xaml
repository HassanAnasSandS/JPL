<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:svc="clr-namespace:JPL.Services"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Pages.TournamentsPage"
             x:Name="ThisPage"
             x:DataType="vm:TournamentsViewModel"
             Title="Tournaments"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Tournaments"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{x:Static svc:BrandSlogans.Catalog}"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       LineBreakMode="WordWrap" />
                <Label Text="{Binding CountLabel}"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="Round robin · groups · knockouts"
                       Style="{StaticResource MutedLabel}"
                       FontSize="12" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="+ New"
                    Style="{StaticResource GoldButton}"
                    Padding="16,10"
                    VerticalOptions="Center"
                    IsVisible="{Binding CanWrite}"
                    Clicked="OnAddClicked" />
        </Grid>

        <ctrl:FilterDrawer Grid.Row="1"
                           HasActiveFilters="{Binding HasFilter}"
                           ClearCommand="{Binding ClearFilterCommand}">
            <SearchBar Placeholder="Filter name / status / champion"
                       Text="{Binding NameFilter}"
                       CancelButtonColor="{StaticResource Primary}" />
        </ctrl:FilterDrawer>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None"
                            RemainingItemsThreshold="1"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            EmptyView="No tournaments yet. Create one to schedule round-robin fixtures.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TournamentRow">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="17"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding MetaLine}"
                                               FontSize="12"
                                               Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            BackgroundColor="#E8EEF5"
                                            Padding="10,6"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding StatusText}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding WinnerLine}"
                                       IsVisible="{Binding HasWinner}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Secondary}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Open"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            Clicked="OnOpenClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Sync"
                                            Padding="12,6"
                                            FontSize="12"
                                            Style="{StaticResource GoldButton}"
                                            IsVisible="{Binding NeedsSync}"
                                            Clicked="OnSyncClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Edit"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#E8EEF5"
                                            TextColor="{StaticResource Primary}"
                                            IsVisible="{Binding CanEdit}"
                                            Clicked="OnEditClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Delete"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#FFE8EC"
                                            TextColor="{StaticResource Danger}"
                                            IsVisible="{Binding CanDelete}"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="12" />
    </Grid>
</ContentPage>
