<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             x:Class="JPL.Pages.LeaguesPage"
             x:Name="ThisPage"
             x:DataType="vm:LeaguesViewModel"
             Title="Leagues"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="Leagues"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{StaticResource Primary}" />
            <Button Grid.Column="1"
                    Text="+ Add"
                    Style="{StaticResource GoldButton}"
                    Padding="16,10"
                    IsVisible="{Binding CanWrite}"
                    Clicked="OnAddClicked" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar Placeholder="Filter league name"
                           Text="{Binding NameFilter}"
                           CancelButtonColor="{StaticResource Primary}" />
                <Button Grid.Column="1"
                        Text="Clear"
                        Style="{StaticResource GhostButton}"
                        Padding="12,8"
                        IsVisible="{Binding HasFilter}"
                        Command="{Binding ClearFilterCommand}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy, Mode=OneWay}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None"
                            EmptyView="No leagues yet.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LeagueRow">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="12">
                            <Grid ColumnDefinitions="56,*,Auto,Auto" ColumnSpacing="8">
                                <Image Source="{Binding Image}"
                                       HeightRequest="48"
                                       WidthRequest="48"
                                       Aspect="AspectFill"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Primary}" />
                                <Button Grid.Column="2"
                                        Text="Edit"
                                        Padding="12,6"
                                        FontSize="12"
                                        Style="{StaticResource GoldButton}"
                                        IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                        Clicked="OnEditClicked"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="3"
                                        Text="Delete"
                                        Padding="12,6"
                                        FontSize="12"
                                        BackgroundColor="#FFE8EC"
                                        TextColor="{StaticResource Danger}"
                                        IsVisible="{Binding BindingContext.CanWrite, Source={x:Reference ThisPage}, x:DataType={x:Null}}"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="3" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
    </Grid>
</ContentPage>
