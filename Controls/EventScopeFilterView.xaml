<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JPL.ViewModels"
             xmlns:ctrl="clr-namespace:JPL.Controls"
             x:Class="JPL.Controls.EventScopeFilterView"
             x:DataType="vm:EventScopeFilterViewModel">
    <VerticalStackLayout Spacing="8">
        <VerticalStackLayout Spacing="4">
            <Label Text="Filter by"
                   FontSize="12"
                   Style="{StaticResource MutedLabel}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="All"
                            Padding="12,6"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            MinimumHeightRequest="34"
                            BackgroundColor="#EEF1F5"
                            TextColor="{StaticResource Primary}"
                            Command="{Binding SelectModeCommand}"
                            CommandParameter="none">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModeNone}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Tournament"
                            Padding="12,6"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            MinimumHeightRequest="34"
                            BackgroundColor="#EEF1F5"
                            TextColor="{StaticResource Primary}"
                            Command="{Binding SelectModeCommand}"
                            CommandParameter="tournament">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModeTournament}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Series"
                            Padding="12,6"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            MinimumHeightRequest="34"
                            BackgroundColor="#EEF1F5"
                            TextColor="{StaticResource Primary}"
                            Command="{Binding SelectModeCommand}"
                            CommandParameter="series">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModeSeries}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Matches"
                            Padding="12,6"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            MinimumHeightRequest="34"
                            BackgroundColor="#EEF1F5"
                            TextColor="{StaticResource Primary}"
                            Command="{Binding SelectModeCommand}"
                            CommandParameter="matches">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsModeMatch}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>
            <Label Text="Pick Tournament, Series, or Matches — then multi-select below"
                   FontSize="11"
                   Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding IsModeNone}" />
        </VerticalStackLayout>
        <VerticalStackLayout IsVisible="{Binding ShowTournamentDropdown}">
            <ctrl:IdMultiSelectFilterView BindingContext="{Binding TournamentFilter}" />
        </VerticalStackLayout>
        <VerticalStackLayout IsVisible="{Binding ShowSeriesDropdown}">
            <ctrl:IdMultiSelectFilterView BindingContext="{Binding SeriesFilter}" />
        </VerticalStackLayout>
        <VerticalStackLayout IsVisible="{Binding ShowMatchDropdown}">
            <ctrl:IdMultiSelectFilterView BindingContext="{Binding MatchFilter}" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
