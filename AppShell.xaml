<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JPL.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cric360"
    FlyoutBehavior="Flyout"
    FlyoutWidth="280"
    FlyoutBackgroundColor="{StaticResource Primary}"
    FlyoutBackdrop="#99000000"
    FlyoutVerticalScrollMode="Enabled">
    <!-- Custom FlyoutContent is the real menu. Hide the default Shell rows so
         Android does not paint separator lines on top of module names. -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="0" IsVisible="False" />
        </DataTemplate>
    </Shell.ItemTemplate>
</Shell>
